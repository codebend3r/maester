# The build context is the repo root, so this allowlists rather than
# excludes: nothing reaches the image unless it is named here, which keeps
# local data, databases and env files out of it.
*
!package.json
!bun.lock
!tsconfig.base.json
!tooling
!nx.json
!apps/*/*/package.json
!libs/*/*/package.json
!scripts/package.json
!patches
!libs/shared/http
!libs/shared/server
!libs/rookery/core
!apps/rookery/server
!apps/rookery/web
**/node_modules
**/dist
**/data
**/.env*
**/*.db*

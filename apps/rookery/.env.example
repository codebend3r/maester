# Copy to .env beside docker-compose.yml and fill in. Never commit .env.

# rookery's own public address. Plex sends the browser back to
# <PUBLIC_URL>/auth/plex/callback, and cookies are Secure when it is https.
# In development, Vite's address: http://localhost:5180
PUBLIC_URL=

# The bearer token apps present to /internal/session. Generate it once
# (openssl rand -hex 32) and give luwin the same value as ROOKERY_SERVICE_TOKEN.
SERVICE_TOKEN=

# Apps a sign-in may return to, as comma-separated origins.
APP_ORIGINS=https://luwin.maester.example.com

# The parent domain the session cookie is shared across, so luwin sees it.
# Dedicate it to the suite: every host under it receives the cookie, so
# Seerr, Wizarr and anything else public belong outside it. Leave empty when
# everything is served from one host, as in development.
COOKIE_DOMAIN=maester.example.com

# Optional, with these defaults under Docker.
# PORT=8030
# DATA_DIR=/config

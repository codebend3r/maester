{
  "name": "weirwood",
  "version": "0.1.0",
  "private": true,
  "description": "Nx monorepo for weirwood, a light self-hosted video library and player: the web client, the media server, and the shared core every client builds on",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "nx run-many -t dev -p server web",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "lint": "nx run-many -t lint:ts lint:css",
    "lint:fix": "nx run-many -t lint:ts:fix lint:css:fix",
    "format": "nx run-many -t format",
    "format:check": "nx run-many -t format:check",
    "verify": "nx run-many -t lint:ts lint:css format:check typecheck test build",
    "affected": "nx affected -t lint:ts lint:css format:check typecheck test build",
    "graph": "nx graph",
    "docker:build": "docker build -t weirwood .",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "nx": "23.2.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0"
  },
  "packageManager": "bun@1.4.2",
  "nx": {
    "includedScripts": []
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "nx"
  ]
}

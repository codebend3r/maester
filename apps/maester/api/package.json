{
  "name": "@maester/api",
  "private": true,
  "description": "maester's agent, tools, chat and FastAPI app: a Python 3.12 project run through uv",
  "scripts": {
    "dev": "cd .. && uv run --project api maester",
    "test": "uv run pytest -q",
    "eval": "uv run maester-eval --model fake",
    "lint:py": "uv run ruff check .",
    "lint:py:fix": "uv run ruff check --fix .",
    "format": "uv run ruff format .",
    "format:check": "uv run ruff format --check ."
  },
  "nx": {
    "projectType": "application",
    "tags": [
      "scope:maester",
      "lang:py"
    ],
    "includedScripts": [
      "dev",
      "test",
      "eval",
      "lint:py",
      "lint:py:fix",
      "format",
      "format:check"
    ]
  }
}

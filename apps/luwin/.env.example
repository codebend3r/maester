# Copy to .env and fill in. Never commit .env.

# --- LLM ---
ANTHROPIC_API_KEY=
LUWIN_MODEL=claude-opus-5-5
LUWIN_EFFORT=medium

# --- Seerr (single) ---
SEERR_URL=http://192.168.50.3:5055
SEERR_API_KEY=
# Seerr's webhook agent sends this as its Authorization Header; the route refuses all without it.
SEERR_WEBHOOK_SECRET=

# --- Plex (single) ---
PLEX_URL=http://192.168.50.3:32400
# The server owner's token: besides the server, it reads and changes friends'
# library shares on plex.tv when the admin approves an access change, and its
# account is luwin's admin.
PLEX_TOKEN=

# --- Sign-in: rookery ---
# rookery signs friends in with Plex and sets the session cookie luwin reads. luwin
# asks it on the LAN who a session belongs to, with the service token rookery has
# for luwin (its SERVICE_TOKEN), and sends browsers to the public address to sign in.
ROOKERY_URL=http://192.168.50.2:8030
ROOKERY_PUBLIC_URL=
ROOKERY_SERVICE_TOKEN=

# --- Wizarr (single) ---
WIZARR_URL=http://192.168.50.2:5690
WIZARR_API_KEY=
# How long an invite link works (Wizarr honors 1, 7 or 30; others snap up), and how
# long access lasts once someone joins (0 for no end).
INVITE_EXPIRES_DAYS=7
INVITE_ACCESS_DAYS=35
# Where friends open an invite link (<this>/j/<code>): Wizarr's public address, not
# the LAN one above.
WIZARR_PUBLIC_URL=
# Wizarr server names an invite shares from (wizteros' entry tiers share Meleys only);
# empty for every server.
INVITE_SERVERS=Meleys
# Library names an invite shares, with or without their "NN. " prefix; empty for
# every library that isn't 4K or private.
INVITE_LIBRARIES=
# Library names never shared, as a regular expression (wizteros' "9X." libraries).
PRIVATE_LIBRARIES=^9\d\.
# Friends get a DM before their access ends, on each of EXPIRY_REMIND_DAYS (7,1 by
# default). Monthly renewals of 35-day access land within a week of the end, so 4,1
# reminds only those whose access didn't renew. The text can use {when} ("in 7
# days", "tomorrow", "today"), {date} and {renew}, which points at CONTRIBUTION_URL.
EXPIRY_REMIND_DAYS=4,1
CONTRIBUTION_URL=
EXPIRY_REMINDER=

# --- English dubs ---
# Requests for an English dub carry this tag (it must exist in the Sonarr/Radarr
# Seerr sends to), and use this quality profile when one by that name exists.
DUB_TAG=dub
DUB_PROFILE=Dual Audio

# --- Per-host stacks: always name the host ---
# Use the same addresses Seerr's Radarr/Sonarr settings use, so a title's owning
# host can be matched from Seerr's records.
SONARR_MELEYS_URL=http://192.168.50.2:27021
SONARR_MELEYS_API_KEY=
RADARR_MELEYS_URL=http://192.168.50.2:7878
RADARR_MELEYS_API_KEY=
SABNZBD_MELEYS_URL=http://192.168.50.2:27020
SABNZBD_MELEYS_API_KEY=
TAUTULLI_MELEYS_URL=http://192.168.50.2:8181
TAUTULLI_MELEYS_API_KEY=

SONARR_VERMITHOR_URL=http://192.168.50.3:27021
SONARR_VERMITHOR_API_KEY=
RADARR_VERMITHOR_URL=http://192.168.50.3:7878
RADARR_VERMITHOR_API_KEY=
SABNZBD_VERMITHOR_URL=http://192.168.50.3:27020
SABNZBD_VERMITHOR_API_KEY=
TAUTULLI_VERMITHOR_URL=http://192.168.50.3:27022
TAUTULLI_VERMITHOR_API_KEY=

# --- File health check ---
# The read-only media mounts (see docker-compose.yml) the health check may read.
# Nothing outside them is ever opened; with none set, no file is checked.
MEDIA_ROOTS=/Vermithor,/Meleys,/Syrax,/Caraxes,/Vhagar
# Only when an arr reports paths under other names than these mounts:
# comma-separated <arr prefix>=<mount prefix> pairs, e.g. /data/media=/Meleys
MEDIA_PATH_MAP=
# Longest a single ffprobe or ffmpeg run may take, in seconds.
PROBE_TIMEOUT_SECONDS=120

# --- Fleet monitor (optional): CPU and memory per NAS, and the weekly NAS report ---
# wizteros' fleet-monitor on meleys, read with a static bearer token that should
# open only /fleet/cpu, /fleet/memory and /fleet. The monitor has no guard for
# such a token yet, so leave FLEET_MONITOR_URL empty until it does; once it is
# set, the token must be too.
FLEET_MONITOR_URL=
FLEET_MONITOR_TOKEN=

# --- Speed test (optional) ---
# The host this container runs on. The pinned speedtest CLI in the image measures
# the servers' shared internet connection from here; leave empty to go without.
SPEEDTEST_HOST=meleys

# --- Admin console jobs ---
# The server's time zone (IANA name); the digest and the NAS report run by its clock.
TZ=America/Toronto
# The daily digest for the admin, and the weekly NAS health report on
# NAS_REPORT_DAY at the same time.
DIGEST_TIME=08:00
NAS_REPORT_DAY=mon
# How often the stalled-download sweeper looks, and how long a download may be
# stuck before it's blocklisted and searched again.
SWEEP_MINUTES=15
STALLED_HOURS=6
# Files reported from one release group in 30 days before the digest suggests blocking it.
BAD_RELEASE_REPORTS=3

# --- Guardrails ---
REPLACE_DAILY_CAP=3
# A 4K request whose volume is this full (or can't be read) waits for the admin.
STORAGE_PAUSE_4K_PERCENT=90
USER_MESSAGES_PER_HOUR=30
USER_TOKENS_PER_DAY=200000

# --- Storage and web ---
LUWIN_DB_PATH=/data/luwin.db
WEB_PORT=8020

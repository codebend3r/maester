{
  "name": "@luwin/api",
  "version": "0.6.3",
  "private": true,
  "description": "luwin's agent, tools, chat and FastAPI app: a Python 3.12 project run through uv",
  "scripts": {
    "dev": "uv run --directory .. --project api luwin",
    "eval": "uv run --directory .. --project api luwin-eval",
    "format": "uv run ruff format .",
    "format:check": "uv run ruff format --check .",
    "lint:py": "uv run ruff check .",
    "lint:py:fix": "uv run ruff check --fix .",
    "sandbox": "uv run --directory .. --project api luwin-sandbox",
    "test": "uv run pytest -q"
  },
  "nx": {
    "projectType": "application",
    "tags": [
      "scope:luwin",
      "lang:py"
    ],
    "includedScripts": [
      "dev",
      "sandbox",
      "test",
      "eval",
      "lint:py",
      "lint:py:fix",
      "format",
      "format:check"
    ]
  }
}

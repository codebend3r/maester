{
  "name": "@wren/tv",
  "version": "0.10.1",
  "private": true,
  "description": "Wren, raven's music app, on Apple TV and Android TV",
  "main": "index.ts",
  "imports": {
    "#package": "./package.json",
    "#app-config": "./app.config.ts"
  },
  "scripts": {
    "build:android-tv": "ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} JAVA_HOME=\"${JAVA_HOME:-/Applications/Android Studio.app/Contents/jbr/Contents/Home}\" ./android/gradlew -p android assembleRelease",
    "build:tvos": "./scripts/build_tvos.sh",
    "deploy:android-tv": "./scripts/deploy_android_tv.sh",
    "deploy:tvos": "./scripts/deploy_tvos.sh",
    "dev:android-tv": "APP_VARIANT=development expo run:android",
    "dev:tvos": "APP_VARIANT=development NODE_PATH=$PWD/node_modules DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer} expo run:ios --device wren-tv",
    "e2e:android-tv": "bun run --sequential e2e:reverse e2e:android-tv:flows",
    "e2e:android-tv:flows": "maestro test --platform android --udid ${ANDROID_SERIAL:?set ANDROID_SERIAL to the Android TV emulator, as bun run ci:wren:android-tv does} e2e",
    "e2e:reverse": "${ANDROID_HOME:?set ANDROID_HOME to the Android SDK folder}/platform-tools/adb reverse tcp:8490 tcp:8490",
    "e2e:tvos": "DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer} xcodebuild test -project ios/Wren.xcodeproj -scheme WrenRemoteTests -destination \"platform=tvOS Simulator,name=${TVOS_SIMULATOR:-wren-tv}\" -derivedDataPath build/tvos-e2e CODE_SIGNING_ALLOWED=NO",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "images:tv": "./scripts/tv_images.sh",
    "lint:ts": "oxlint",
    "lint:ts:fix": "oxlint --fix",
    "prebuild:android-tv": "expo prebuild --platform android --clean",
    "prebuild:tvos": "NODE_PATH=$PWD/node_modules REACT_NATIVE_NODE_MODULES_DIR=$PWD/node_modules DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer} expo prebuild --platform ios --clean",
    "predev:android-tv": "APP_VARIANT=development bun run prebuild:android-tv",
    "predev:tvos": "APP_VARIANT=development bun run prebuild:tvos",
    "start": "bun run --sequential start:watchman start:metro",
    "start:metro": "expo start",
    "start:watchman": "watchman --version",
    "test": "bun test --dots --path-ignore-patterns=**/*.render.test.tsx src",
    "test:screens": "NODE_PATH=$PWD/node_modules jest",
    "typecheck": "bun run --parallel typecheck:app typecheck:node",
    "typecheck:app": "tsgo --noEmit -p tsconfig.json",
    "typecheck:node": "tsgo --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@babel/runtime": "7.29.7",
    "@expo/metro-runtime": "58.0.17",
    "@raven/audio": "workspace:*",
    "@raven/core": "workspace:*",
    "@raven/native": "workspace:*",
    "@raven/top-shelf": "workspace:*",
    "@raven/ui": "workspace:*",
    "@raven/wren": "workspace:*",
    "@raven/wren-native": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "5.107.1",
    "expo": "58.0.23",
    "expo-constants": "58.0.15",
    "expo-file-system": "58.0.13",
    "expo-font": "58.0.11",
    "expo-linking": "58.0.16",
    "expo-router": "58.0.30",
    "expo-splash-screen": "58.0.13",
    "expo-system-ui": "58.0.7",
    "react": "19.3.0",
    "react-native": "npm:react-native-tvos@0.88.1-0",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.1",
    "react-native-video": "6.19.3",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@react-native-tvos/config-tv": "0.1.7",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "babel-preset-expo": "58.0.24",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "test-renderer": "1.3.1"
  },
  "jest": {
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/jestSetup.ts"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.render.test.tsx"
    ],
    "testTimeout": 30000,
    "transformIgnorePatterns": [
      "/node_modules/(?!(\\.bun|react-native|@react-native|@react-native-community|expo|@expo|react-navigation|@react-navigation|standard-navigation))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "react-native-reanimated",
        "react-native-worklets",
        "react-native-gesture-handler"
      ],
      "android": {
        "exclude": [
          "react-native-reanimated",
          "react-native-worklets",
          "react-native-gesture-handler"
        ]
      }
    }
  },
  "nx": {
    "projectType": "application",
    "tags": [
      "scope:raven",
      "lang:ts"
    ],
    "includedScripts": [
      "start",
      "prebuild:tvos",
      "prebuild:android-tv",
      "build:tvos",
      "build:android-tv",
      "typecheck",
      "lint:ts",
      "lint:ts:fix",
      "format",
      "format:check",
      "test",
      "test:screens",
      "e2e:tvos",
      "e2e:android-tv",
      "dev:tvos",
      "dev:android-tv",
      "deploy:tvos",
      "deploy:android-tv"
    ],
    "namedInputs": {
      "nativeTv": [
        "{workspaceRoot}/patches/react-native-video@*.patch",
        "{workspaceRoot}/apps/wren/wren-app/assets/fonts/*",
        "{workspaceRoot}/apps/raven/app/plugins/withTvRemoteTests.ts",
        "{workspaceRoot}/apps/raven/app/plugins/withoutTvAudioService.ts",
        "{workspaceRoot}/apps/raven/app/scripts/build_tvos.sh",
        "{workspaceRoot}/apps/wren/wren-app/plugins/withCleartextTraffic.ts",
        "expoVariant",
        "{workspaceRoot}/.github/actions/raven-app-setup/**/*"
      ]
    },
    "targets": {
      "start": {
        "continuous": true,
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      },
      "test:screens": {
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production"
        ],
        "cache": true
      },
      "prebuild:tvos": {
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production",
          "nativeTv",
          "xcode"
        ],
        "outputs": [
          "{projectRoot}/ios"
        ],
        "cache": true
      },
      "prebuild:android-tv": {
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production",
          "nativeTv"
        ],
        "outputs": [
          "{projectRoot}/android"
        ],
        "cache": true
      },
      "build:tvos": {
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production",
          "nativeTv",
          "xcode"
        ],
        "outputs": [
          "{projectRoot}/ios/Podfile.lock",
          "{projectRoot}/ios/Pods/Manifest.lock",
          "{projectRoot}/ios/Wren.xcodeproj",
          "{projectRoot}/ios/WrenRemoteTests",
          "{projectRoot}/build/tvos/Build/Products/Release-appletvsimulator/Wren.app"
        ],
        "cache": true
      },
      "build:android-tv": {
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production",
          "nativeTv",
          "gradle"
        ],
        "outputs": [
          "{projectRoot}/android/app/build/outputs/apk/release"
        ],
        "cache": true
      },
      "e2e:tvos": {
        "inputs": [
          "default",
          "^production",
          "nativeTv",
          "xcode",
          {
            "env": "TVOS_SIMULATOR"
          },
          "againstServer"
        ],
        "cache": true
      },
      "e2e:android-tv": {
        "inputs": [
          "default",
          "^production",
          "nativeTv",
          "gradle",
          "{workspaceRoot}/.github/actions/raven-android-avd/**/*",
          "againstServer"
        ],
        "cache": true
      },
      "dev:tvos": {
        "continuous": true,
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      },
      "dev:android-tv": {
        "continuous": true,
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      },
      "deploy:tvos": {
        "dependsOn": [
          "^build"
        ],
        "cache": false
      },
      "deploy:android-tv": {
        "dependsOn": [
          "build:android-tv"
        ],
        "cache": false
      }
    }
  }
}

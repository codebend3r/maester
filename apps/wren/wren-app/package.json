{
  "name": "@wren/app",
  "version": "0.10.2",
  "private": true,
  "description": "Wren, raven's music app for iPhone, iPad and Android phones",
  "main": "index.ts",
  "imports": {
    "#package": "./package.json",
    "#app-config": "./app.config.ts",
    "#plugins/*": "./plugins/*.ts"
  },
  "scripts": {
    "build:android": "../../raven/app/scripts/assemble_android.sh",
    "build:ios": "DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer} xcodebuild -workspace ios/Wren.xcworkspace -scheme Wren -configuration Release -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath build/ios ARCHS=arm64 ONLY_ACTIVE_ARCH=NO CODE_SIGN_IDENTITY=- CODE_SIGNING_REQUIRED=NO build",
    "deploy:ios": "./scripts/deploy_ios.sh",
    "dev:android": "APP_VARIANT=development expo run:android",
    "dev:ios": "APP_VARIANT=development NODE_PATH=$PWD/node_modules DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer} expo run:ios --device wren-phone",
    "e2e": "DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer} maestro test --platform ios e2e",
    "e2e:android": "bun run --sequential e2e:reverse e2e:android:flows",
    "e2e:android:flows": "maestro test --platform android --udid ${ANDROID_SERIAL:?set ANDROID_SERIAL to the Android phone emulator, as bun run ci:wren:android does} e2e",
    "e2e:ipad": "bun run e2e",
    "e2e:reverse": "${ANDROID_HOME:?set ANDROID_HOME to the Android SDK folder}/platform-tools/adb reverse tcp:8490 tcp:8490",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint:ts": "oxlint",
    "lint:ts:fix": "oxlint --fix",
    "prebuild:android": "expo prebuild --platform android --clean",
    "prebuild:ios": "NODE_PATH=$PWD/node_modules REACT_NATIVE_NODE_MODULES_DIR=$PWD/node_modules DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer} expo prebuild --platform ios --clean",
    "predev:android": "APP_VARIANT=development bun run prebuild:android",
    "predev:ios": "APP_VARIANT=development bun run prebuild:ios",
    "start": "bun run --sequential start:watchman start:metro",
    "start:metro": "expo start",
    "start:watchman": "watchman --version",
    "test": "bun test --dots --path-ignore-patterns=**/*.render.test.tsx src",
    "test:screens": "NODE_PATH=$PWD/node_modules jest",
    "typecheck": "bun run --parallel typecheck:app typecheck:node",
    "typecheck:app": "tsgo --noEmit -p tsconfig.json",
    "typecheck:node": "tsgo --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@babel/runtime": "7.29.7",
    "@expo/metro-runtime": "58.0.17",
    "@raven/audio": "workspace:*",
    "@raven/core": "workspace:*",
    "@raven/native": "workspace:*",
    "@raven/ui": "workspace:*",
    "@raven/wren": "workspace:*",
    "@raven/wren-native": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "5.107.1",
    "expo": "58.0.23",
    "expo-constants": "58.0.15",
    "expo-file-system": "58.0.13",
    "expo-font": "58.0.11",
    "expo-linking": "58.0.16",
    "expo-router": "58.0.30",
    "expo-splash-screen": "58.0.13",
    "expo-system-ui": "58.0.7",
    "react": "19.3.0",
    "react-native": "npm:react-native-tvos@0.88.1-0",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.1",
    "react-native-worklets": "0.13.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "babel-preset-expo": "58.0.24",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "test-renderer": "1.3.1"
  },
  "jest": {
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^expo-file-system$": "<rootDir>/node_modules/expo-file-system"
    },
    "preset": "jest-expo",
    "resolver": "react-native-reanimated/jest/resolver",
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/jestSetup.ts"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.render.test.tsx"
    ],
    "testTimeout": 30000,
    "transformIgnorePatterns": [
      "/node_modules/(?!(\\.bun|react-native|@react-native|@react-native-community|expo|@expo|react-navigation|@react-navigation|standard-navigation))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "nx": {
    "projectType": "application",
    "tags": [
      "scope:raven",
      "lang:ts"
    ],
    "includedScripts": [
      "start",
      "prebuild:ios",
      "prebuild:android",
      "build:ios",
      "build:android",
      "deploy:ios",
      "typecheck",
      "lint:ts",
      "lint:ts:fix",
      "format",
      "format:check",
      "test",
      "test:screens",
      "e2e",
      "e2e:ipad",
      "e2e:android",
      "dev:ios",
      "dev:android"
    ],
    "targets": {
      "start": {
        "continuous": true,
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      },
      "test:screens": {
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production"
        ],
        "cache": true
      },
      "build:ios": {
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production",
          "expoVariant",
          {
            "env": "WREN_CARPLAY"
          },
          "xcode"
        ],
        "outputs": [
          "{projectRoot}/ios/Podfile.lock",
          "{projectRoot}/ios/Pods/Manifest.lock",
          "{projectRoot}/build/ios/Build/Products/Release-iphonesimulator/Wren.app"
        ],
        "cache": true
      },
      "build:android": {
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production",
          "expoVariant",
          "gradle",
          "{workspaceRoot}/apps/raven/app/scripts/assemble_android.sh"
        ],
        "outputs": [
          "{projectRoot}/android/app/build/outputs/apk/release"
        ],
        "cache": true
      },
      "deploy:ios": {
        "dependsOn": [
          "^build"
        ],
        "cache": false
      },
      "prebuild:ios": {
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production",
          "expoVariant",
          {
            "env": "WREN_CARPLAY"
          },
          "xcode"
        ],
        "outputs": [
          "{projectRoot}/ios"
        ],
        "cache": true
      },
      "prebuild:android": {
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production",
          "expoVariant"
        ],
        "outputs": [
          "{projectRoot}/android"
        ],
        "cache": true
      },
      "e2e": {
        "inputs": [
          "default",
          "^production",
          "expoVariant",
          "xcode",
          "{workspaceRoot}/.github/actions/raven-app-setup/**/*",
          "againstServer"
        ],
        "cache": true
      },
      "e2e:ipad": {
        "inputs": [
          "default",
          "^production",
          "expoVariant",
          "xcode",
          "{workspaceRoot}/.github/actions/raven-app-setup/**/*",
          "againstServer"
        ],
        "cache": true
      },
      "e2e:android": {
        "inputs": [
          "default",
          "^production",
          "expoVariant",
          "gradle",
          "{workspaceRoot}/.github/actions/raven-android-avd/**/*",
          "{workspaceRoot}/.github/actions/raven-app-setup/**/*",
          "againstServer"
        ],
        "cache": true
      },
      "dev:ios": {
        "continuous": true,
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      },
      "dev:android": {
        "continuous": true,
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      }
    }
  }
}

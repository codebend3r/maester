{
  "name": "@raven/app",
  "version": "0.7.3",
  "private": true,
  "description": "raven on iPhone, iPad, Apple TV and Android TV",
  "main": "index.ts",
  "imports": {
    "#package": "./package.json"
  },
  "scripts": {
    "build:android-tv": "./android/gradlew -p android assembleRelease",
    "build:ios": "DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer} xcodebuild -workspace ios/raven.xcworkspace -scheme raven -configuration Release -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath build/ios ARCHS=arm64 ONLY_ACTIVE_ARCH=NO CODE_SIGN_IDENTITY=- CODE_SIGNING_REQUIRED=NO build",
    "build:tvos": "DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer} xcodebuild -workspace ios/raven.xcworkspace -scheme raven -configuration Release -sdk appletvsimulator -destination 'generic/platform=tvOS Simulator' -derivedDataPath build/tvos ARCHS=arm64 ONLY_ACTIVE_ARCH=NO CODE_SIGN_IDENTITY=- CODE_SIGNING_REQUIRED=NO build",
    "dev:ios": "APP_VARIANT=development NODE_PATH=$PWD/node_modules DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer} expo run:ios --device raven-phone",
    "dev:ipad": "APP_VARIANT=development NODE_PATH=$PWD/node_modules DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer} expo run:ios --device raven-pad",
    "dev:tvos": "EXPO_TV=1 APP_VARIANT=development NODE_PATH=$PWD/node_modules DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer} expo run:ios --device raven-tv",
    "e2e": "DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer} maestro test --platform ios --exclude-tags dpad e2e",
    "e2e:android-tv": "bun run --sequential e2e:android-tv:reverse e2e:android-tv:flows",
    "e2e:android-tv:flows": "maestro test --platform android --exclude-tags touch e2e",
    "e2e:android-tv:reverse": "${ANDROID_HOME:?set ANDROID_HOME to the Android SDK folder}/platform-tools/adb reverse tcp:8490 tcp:8490",
    "e2e:tvos": "DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer} xcodebuild test -project ios/raven.xcodeproj -scheme RavenRemoteTests -destination \"platform=tvOS Simulator,name=${TVOS_SIMULATOR:-Apple TV 4K (3rd generation)}\" -derivedDataPath build/tvos-e2e CODE_SIGNING_ALLOWED=NO",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint:ts": "oxlint",
    "lint:ts:fix": "oxlint --fix",
    "prebuild:android-tv": "EXPO_TV=1 expo prebuild --platform android --clean",
    "prebuild:ios": "NODE_PATH=$PWD/node_modules DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer} expo prebuild --platform ios --clean",
    "prebuild:tvos": "EXPO_TV=1 NODE_PATH=$PWD/node_modules DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer} expo prebuild --platform ios --clean",
    "predev:ios": "APP_VARIANT=development bun run prebuild:ios",
    "predev:ipad": "APP_VARIANT=development bun run prebuild:ios",
    "predev:tvos": "APP_VARIANT=development bun run prebuild:tvos",
    "start": "bun run --sequential start:watchman start:metro",
    "start:metro": "expo start",
    "start:watchman": "watchman --version",
    "test": "bun test --dots --path-ignore-patterns=**/*.render.test.tsx src",
    "test:screens": "NODE_PATH=$PWD/node_modules jest",
    "typecheck": "bun run --parallel typecheck:app typecheck:node",
    "typecheck:app": "tsgo --noEmit -p tsconfig.json",
    "typecheck:node": "tsgo --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@babel/runtime": "7.29.7",
    "@expo/metro-runtime": "58.0.14",
    "@formatjs/intl-displaynames": "7.3.15",
    "@formatjs/intl-getcanonicallocales": "3.2.12",
    "@formatjs/intl-locale": "5.3.12",
    "@formatjs/intl-pluralrules": "6.3.15",
    "@formatjs/intl-relativetimeformat": "12.3.15",
    "@raven/core": "workspace:*",
    "@raven/ui": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "5.103.1",
    "expo": "58.0.14",
    "expo-constants": "58.0.12",
    "expo-crypto": "58.0.7",
    "expo-keep-awake": "58.0.3",
    "expo-linking": "58.0.13",
    "expo-router": "58.0.23",
    "expo-secure-store": "58.0.2",
    "react": "19.3.0",
    "react-native": "npm:react-native-tvos@0.88.0-0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-sse": "1.2.1",
    "react-native-video": "6.19.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@react-native-tvos/config-tv": "0.1.7",
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "babel-preset-expo": "58.0.17",
    "jest": "30.5.2",
    "jest-expo": "58.0.11",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "test-renderer": "1.3.0"
  },
  "jest": {
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/jestSetup.ts"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.render.test.tsx"
    ],
    "testTimeout": 30000,
    "transformIgnorePatterns": [
      "/node_modules/(?!(\\.bun|react-native|@react-native|@react-native-community|expo|@expo|react-navigation|@react-navigation|standard-navigation))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "react-native-reanimated",
        "react-native-worklets",
        "react-native-gesture-handler"
      ]
    }
  },
  "nx": {
    "projectType": "application",
    "tags": [
      "scope:raven",
      "lang:ts"
    ],
    "includedScripts": [
      "start",
      "prebuild:ios",
      "prebuild:tvos",
      "prebuild:android-tv",
      "build:ios",
      "build:tvos",
      "build:android-tv",
      "typecheck",
      "lint:ts",
      "lint:ts:fix",
      "format",
      "format:check",
      "test",
      "test:screens",
      "e2e",
      "e2e:tvos",
      "e2e:android-tv",
      "dev:ios",
      "dev:ipad",
      "dev:tvos"
    ],
    "targets": {
      "start": {
        "continuous": true,
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      },
      "test:screens": {
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production"
        ],
        "cache": true
      },
      "build:ios": {
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production",
          {
            "env": "APP_VARIANT"
          },
          {
            "env": "DEVELOPER_DIR"
          },
          {
            "runtime": "xcodebuild -version"
          }
        ],
        "outputs": [
          "{projectRoot}/ios",
          "{projectRoot}/build/ios"
        ],
        "cache": true
      },
      "build:tvos": {
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production",
          {
            "env": "APP_VARIANT"
          },
          {
            "env": "DEVELOPER_DIR"
          },
          {
            "runtime": "xcodebuild -version"
          }
        ],
        "outputs": [
          "{projectRoot}/ios",
          "{projectRoot}/build/tvos"
        ],
        "cache": true
      },
      "build:android-tv": {
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production",
          {
            "env": "APP_VARIANT"
          }
        ],
        "outputs": [
          "{projectRoot}/android"
        ],
        "cache": true
      },
      "prebuild:ios": {
        "inputs": [
          "default",
          "^production",
          {
            "env": "APP_VARIANT"
          },
          {
            "env": "DEVELOPER_DIR"
          },
          {
            "runtime": "xcodebuild -version"
          }
        ],
        "outputs": [
          "{projectRoot}/ios"
        ],
        "cache": true
      },
      "prebuild:tvos": {
        "inputs": [
          "default",
          "^production",
          {
            "env": "APP_VARIANT"
          },
          {
            "env": "DEVELOPER_DIR"
          },
          {
            "runtime": "xcodebuild -version"
          }
        ],
        "outputs": [
          "{projectRoot}/ios"
        ],
        "cache": true
      },
      "prebuild:android-tv": {
        "inputs": [
          "default",
          "^production",
          {
            "env": "APP_VARIANT"
          }
        ],
        "outputs": [
          "{projectRoot}/android"
        ],
        "cache": true
      },
      "e2e": {
        "inputs": [
          "default",
          "^production",
          {
            "env": "APP_VARIANT"
          },
          {
            "env": "DEVELOPER_DIR"
          },
          {
            "runtime": "xcodebuild -version"
          },
          "{workspaceRoot}/apps/raven/server/src/**/*"
        ],
        "cache": true
      },
      "dev:ios": {
        "continuous": true,
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      },
      "dev:ipad": {
        "continuous": true,
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      },
      "dev:tvos": {
        "continuous": true,
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      }
    }
  }
}

{
  "name": "@raven/music-web",
  "version": "0.9.1",
  "private": true,
  "description": "Wren on the web: raven's music app in a browser",
  "type": "module",
  "imports": {
    "#package": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint:css": "gale \"src/**/*.scss\"",
    "lint:css:fix": "gale --fix \"src/**/*.scss\"",
    "lint:ts": "oxlint",
    "lint:ts:fix": "oxlint --fix",
    "preview": "vite preview",
    "test": "bun test --dots",
    "test:watch": "bun test --dots --watch",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/young-serif": "5.3.0",
    "@raven/core": "workspace:*",
    "@raven/ui": "workspace:*",
    "@raven/wren": "workspace:*",
    "@shared/http": "workspace:*",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@tanstack/react-query": "5.107.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.5",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@codebend3r/gale": "0.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@tooling/web": "workspace:*",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "6.2.1",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "sass": "1.108.1",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "nx": {
    "projectType": "application",
    "tags": [
      "scope:web",
      "lang:ts"
    ],
    "includedScripts": [
      "dev",
      "build",
      "preview",
      "typecheck",
      "lint:ts",
      "lint:ts:fix",
      "lint:css",
      "lint:css:fix",
      "format",
      "format:check",
      "test",
      "test:watch"
    ],
    "targets": {
      "build": {
        "inputs": [
          "production",
          "^production",
          {
            "env": "NETLIFY"
          }
        ]
      }
    }
  }
}

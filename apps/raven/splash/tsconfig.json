{
  // A static page: Vite, TypeScript and SCSS, no React.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "paths": {
      "@/e2e/*": ["./e2e/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "e2e",
    "vite.config.ts",
    "playwright.config.ts",
    "../../../tooling/web/assets.d.ts"
  ]
}

{
  "name": "@raven/server",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run --sequential build:clean build:compile build:aliases",
    "build:aliases": "tsc-alias -p tsconfig.build.json",
    "build:clean": "rm -rf dist",
    "build:compile": "tsc -p tsconfig.build.json",
    "dev": "SCAN_ON_START=false RAVEN_LOG_REQUESTS=true tsx watch --env-file-if-exists=../.env src/main.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint:ts": "oxlint",
    "lint:ts:fix": "oxlint --fix",
    "serve:fixture": "tsx src/e2e/fixtureServer.ts",
    "serve:lighthouse": "tsx src/e2e/lighthouseServer.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsgo --noEmit",
    "markers:accuracy": "tsx src/markers/markerAccuracy.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-fastify": "12.3.3",
    "@raven/core": "workspace:*",
    "@shared/server": "workspace:*",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.8",
    "jose": "6.2.12",
    "music-metadata": "12.3.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "tsc-alias": "1.9.7",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "nx": {
    "projectType": "application",
    "tags": [
      "scope:server",
      "lang:ts"
    ],
    "includedScripts": [
      "build",
      "dev",
      "serve:fixture",
      "serve:lighthouse",
      "markers:accuracy",
      "typecheck",
      "lint:ts",
      "lint:ts:fix",
      "format",
      "format:check",
      "test",
      "test:watch"
    ],
    "targets": {
      "serve:fixture": {
        "continuous": true,
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      },
      "serve:lighthouse": {
        "continuous": true,
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      },
      "markers:accuracy": {
        "cache": false
      }
    }
  }
}

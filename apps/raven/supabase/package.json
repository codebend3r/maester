{
  "name": "@raven/supabase",
  "version": "0.10.2",
  "private": true,
  "type": "module",
  "scripts": {
    "db:keys": "bash scripts/keys.sh",
    "db:login": "supabase login --workdir ..",
    "db:link": "supabase link --workdir ..",
    "db:start": "bun run --sequential db:keys db:containers",
    "db:containers": "supabase start --workdir .. -x realtime,storage-api,imgproxy,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "db:start:ci": "bun run --sequential db:keys db:containers:ci",
    "db:containers:ci": "supabase start --workdir .. -x realtime,storage-api,imgproxy,postgres-meta,studio,edge-runtime,logflare,vector,supavisor,mailpit",
    "db:stop": "supabase stop --workdir ..",
    "db:reset": "supabase db reset --workdir ..",
    "db:status": "supabase status --workdir ..",
    "test:db": "supabase test db --workdir ..",
    "test:db:ci": "bun run --sequential db:start:ci test:db lint:db",
    "lint:db": "supabase db lint --workdir .. --local --schema public,private --fail-on warning",
    "lint:ts": "oxlint",
    "lint:ts:fix": "oxlint --fix",
    "check:functions": "bun run --parallel check:functions:alert check:functions:device",
    "check:functions:alert": "deno check --config functions/signup-alert/deno.json functions/signup-alert",
    "check:functions:device": "deno check --config functions/device-sign-in/deno.json functions/device-sign-in",
    "test:functions": "bun run --parallel test:functions:alert test:functions:device",
    "test:functions:alert": "deno test --config functions/signup-alert/deno.json functions/signup-alert",
    "test:functions:device": "deno test --config functions/device-sign-in/deno.json functions/device-sign-in",
    "deploy": "bun run --sequential deploy:check deploy:db deploy:config deploy:functions",
    "deploy:check": "bash scripts/production.sh diff",
    "deploy:db": "supabase db push --remote --workdir ..",
    "deploy:config": "bash scripts/production.sh push",
    "deploy:functions": "supabase functions deploy signup-alert device-sign-in --use-api --workdir ..",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "supabase": "3.0.0"
  },
  "nx": {
    "projectType": "application",
    "tags": [
      "scope:raven",
      "lang:sql"
    ],
    "includedScripts": [
      "db:keys",
      "db:login",
      "db:link",
      "db:start",
      "db:start:ci",
      "db:stop",
      "db:reset",
      "db:status",
      "test:db",
      "test:db:ci",
      "lint:db",
      "lint:ts",
      "lint:ts:fix",
      "check:functions",
      "test:functions",
      "deploy",
      "deploy:db",
      "format",
      "format:check"
    ],
    "namedInputs": {
      "functions": [
        "{projectRoot}/functions/**/*",
        {
          "runtime": "deno --version"
        }
      ]
    },
    "targets": {
      "check:functions": {
        "cache": true,
        "inputs": [
          "functions"
        ]
      },
      "test:functions": {
        "cache": true,
        "inputs": [
          "functions"
        ]
      },
      "test:db:ci": {
        "cache": true,
        "inputs": [
          "default"
        ]
      }
    }
  }
}

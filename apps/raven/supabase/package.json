{
  "name": "@raven/supabase",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "scripts": {
    "db:keys": "bash scripts/keys.sh",
    "db:login": "supabase login --workdir ..",
    "db:link": "supabase link --workdir ..",
    "db:start": "bun run --sequential db:keys db:containers",
    "db:containers": "supabase start --workdir .. -x realtime,storage-api,imgproxy,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop --workdir ..",
    "db:reset": "supabase db reset --workdir ..",
    "db:status": "supabase status --workdir ..",
    "test:db": "supabase test db --workdir ..",
    "lint:db": "supabase db lint --workdir .. --local --schema public,private --fail-on warning",
    "lint:ts": "oxlint",
    "lint:ts:fix": "oxlint --fix",
    "check:functions": "deno check --config functions/signup-alert/deno.json functions/signup-alert",
    "test:functions": "deno test --config functions/signup-alert/deno.json functions/signup-alert",
    "deploy": "bun run --sequential deploy:check deploy:db deploy:config deploy:functions",
    "deploy:check": "bash scripts/production.sh diff",
    "deploy:db": "supabase db push --workdir ..",
    "deploy:config": "bash scripts/production.sh push",
    "deploy:functions": "supabase functions deploy signup-alert --use-api --workdir ..",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "supabase": "2.121.0"
  },
  "nx": {
    "projectType": "application",
    "tags": [
      "scope:raven",
      "lang:sql"
    ],
    "includedScripts": [
      "db:keys",
      "db:login",
      "db:link",
      "db:start",
      "db:stop",
      "db:reset",
      "db:status",
      "test:db",
      "lint:db",
      "lint:ts",
      "lint:ts:fix",
      "check:functions",
      "test:functions",
      "deploy",
      "format",
      "format:check"
    ]
  }
}

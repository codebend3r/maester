{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["../../../tooling/oxlint/node.json"],
  "ignorePatterns": ["dist", "out", "test-results"],
  "overrides": [
    {
      "files": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/renderer/test/**"],
      "rules": {
        "typescript/no-non-null-assertion": "off",
        "unicorn/consistent-function-scoping": "off"
      }
    }
  ]
}

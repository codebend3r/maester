{
  "name": "@raven/desktop",
  "version": "0.6.3",
  "private": true,
  "description": "raven player: local videos under raven's own controls",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "audit:bundle": "bun src/build/auditBundle.ts",
    "build": "bun run --sequential build:clean build:renderer build:main build:preload",
    "build:clean": "rm -rf dist",
    "build:main": "bun build src/main/main.ts --target node --format esm --external electron --sourcemap=linked --outdir dist/main",
    "build:preload": "bun build src/preload/preload.ts --target node --format cjs --external electron --outfile dist/preload/preload.cjs",
    "build:renderer": "vite build",
    "dev": "electron .",
    "e2e": "playwright test",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "install:electron": "install-electron",
    "lint:css": "gale \"src/**/*.scss\"",
    "lint:css:fix": "gale --fix \"src/**/*.scss\"",
    "lint:ts": "oxlint",
    "lint:ts:fix": "oxlint --fix",
    "make": "electron-forge make",
    "package": "electron-forge package",
    "release:assets": "bun src/build/releaseAssets.ts",
    "smoke:packaged": "bun src/build/smokePackaged.ts",
    "stage:mpv": "bun src/build/stageMpv.ts",
    "test": "bun run --sequential test:main test:renderer",
    "test:main": "bun test --dots src/main src/shared src/preload src/build",
    "test:native": "node --import tsx --test --test-timeout=120000 test/player.native.ts",
    "test:renderer": "bun test --dots --preload ./src/renderer/test/happy-dom.ts --preload ../../../tooling/web/scss-modules.ts --preload ./src/renderer/test/setup.ts src/renderer",
    "test:watch": "bun test --dots --watch src/main src/shared",
    "typecheck": "bun run --parallel typecheck:main typecheck:preload typecheck:renderer",
    "typecheck:main": "tsgo --noEmit -p tsconfig.main.json",
    "typecheck:preload": "tsgo --noEmit -p tsconfig.preload.json",
    "typecheck:renderer": "tsgo --noEmit -p tsconfig.renderer.json"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/young-serif": "5.3.0",
    "@raven/core": "workspace:*",
    "@raven/mpv": "workspace:*",
    "@raven/ui": "workspace:*",
    "@tanstack/react-query": "5.103.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@codebend3r/gale": "0.3.1",
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-base": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@happy-dom/global-registrator": "20.14.5",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/bun": "1.4.2",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.7.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "sass": "1.104.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "nx": {
    "projectType": "application",
    "tags": [
      "scope:desktop",
      "lang:ts"
    ],
    "includedScripts": [
      "build",
      "build:clean",
      "build:renderer",
      "build:main",
      "build:preload",
      "typecheck",
      "typecheck:main",
      "typecheck:preload",
      "typecheck:renderer",
      "lint:ts",
      "lint:ts:fix",
      "lint:css",
      "lint:css:fix",
      "format",
      "format:check",
      "test",
      "test:main",
      "test:renderer",
      "test:watch",
      "test:native",
      "dev",
      "e2e",
      "install:electron",
      "stage:mpv",
      "package",
      "make",
      "audit:bundle",
      "smoke:packaged",
      "release:assets"
    ],
    "targets": {
      "dev": {
        "dependsOn": [
          "build",
          "install:electron"
        ]
      },
      "e2e": {
        "cache": true,
        "dependsOn": [
          "build",
          "install:electron"
        ],
        "inputs": [
          "default",
          "^production",
          {
            "runtime": "xcodebuild -version"
          },
          {
            "runtime": "uname -m"
          }
        ]
      },
      "test:native": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production",
          {
            "runtime": "xcodebuild -version"
          },
          {
            "runtime": "uname -m"
          }
        ]
      },
      "install:electron": {
        "cache": false
      },
      "stage:mpv": {
        "cache": false
      },
      "package": {
        "cache": false,
        "dependsOn": [
          "build",
          "stage:mpv"
        ]
      },
      "make": {
        "cache": true,
        "dependsOn": [
          "build",
          "stage:mpv"
        ],
        "inputs": [
          "production",
          "^production",
          {
            "env": "RAVEN_SIGN_IDENTITY"
          },
          {
            "env": "RAVEN_NOTARIZE_PROFILE"
          },
          {
            "runtime": "xcodebuild -version"
          },
          {
            "runtime": "uname -m"
          }
        ],
        "outputs": [
          "{projectRoot}/out"
        ]
      },
      "audit:bundle": {
        "cache": false
      },
      "smoke:packaged": {
        "cache": false
      },
      "release:assets": {
        "cache": false
      }
    }
  },
  "productName": "raven player"
}

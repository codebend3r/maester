{
  "name": "@raven/desktop",
  "version": "0.7.8",
  "private": true,
  "description": "Raven: local videos under raven's own controls",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "audit:bundle": "bun src/build/auditBundle.ts",
    "build": "bun run --sequential build:clean build:main build:preload",
    "build:clean": "rm -rf dist",
    "build:main": "bun build src/main/main.ts --target node --format esm --external electron --sourcemap=linked --define process.env.RAVEN_DESKTOP_SERVER_ORIGIN=\\\"$RAVEN_DESKTOP_SERVER_ORIGIN\\\" --define process.env.RAVEN_DESKTOP_LINK_ORIGINS=\\\"$RAVEN_DESKTOP_LINK_ORIGINS\\\" --outdir dist/main",
    "build:preload": "bun build src/preload/preload.ts --target node --format cjs --external electron --outfile dist/preload/preload.cjs",
    "dev": "electron .",
    "e2e": "playwright test",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "install:electron": "install-electron",
    "lint:ts": "oxlint",
    "lint:ts:fix": "oxlint --fix",
    "make": "electron-forge make",
    "package": "electron-forge package",
    "release:assets": "bun src/build/releaseAssets.ts",
    "smoke:packaged": "bun src/build/smokePackaged.ts",
    "stage:mpv": "bun src/build/stageMpv.ts",
    "test": "bun test --dots src/main src/shared src/preload src/build",
    "test:native": "node --import tsx --test --test-timeout=120000 test/player.native.ts",
    "test:watch": "bun test --dots --watch src/main src/shared",
    "typecheck": "bun run --parallel typecheck:main typecheck:preload",
    "typecheck:main": "tsgo --noEmit -p tsconfig.main.json",
    "typecheck:preload": "tsgo --noEmit -p tsconfig.preload.json"
  },
  "dependencies": {
    "@raven/core": "workspace:*",
    "@raven/mpv": "workspace:*"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-base": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.2",
    "@types/node": "24.19.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "electron": "44.7.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "nx": {
    "projectType": "application",
    "tags": [
      "scope:desktop",
      "lang:ts"
    ],
    "includedScripts": [
      "build",
      "build:clean",
      "build:main",
      "build:preload",
      "typecheck",
      "typecheck:main",
      "typecheck:preload",
      "lint:ts",
      "lint:ts:fix",
      "format",
      "format:check",
      "test",
      "test:watch",
      "test:native",
      "dev",
      "e2e",
      "install:electron",
      "stage:mpv",
      "package",
      "make",
      "audit:bundle",
      "smoke:packaged",
      "release:assets"
    ],
    "targets": {
      "build": {
        "dependsOn": [
          "^build",
          {
            "projects": [
              "@raven/web"
            ],
            "target": "build"
          }
        ],
        "inputs": [
          "production",
          "^production",
          {
            "env": "RAVEN_DESKTOP_SERVER_ORIGIN"
          },
          {
            "env": "RAVEN_DESKTOP_LINK_ORIGINS"
          }
        ]
      },
      "dev": {
        "dependsOn": [
          "build",
          "install:electron"
        ]
      },
      "e2e": {
        "cache": true,
        "dependsOn": [
          "build",
          "install:electron"
        ],
        "inputs": [
          "default",
          "^production",
          {
            "runtime": "xcodebuild -version"
          },
          {
            "runtime": "uname -m"
          }
        ]
      },
      "test:native": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production",
          {
            "runtime": "xcodebuild -version"
          },
          {
            "runtime": "uname -m"
          }
        ]
      },
      "install:electron": {
        "cache": false
      },
      "stage:mpv": {
        "cache": false
      },
      "package": {
        "cache": false,
        "dependsOn": [
          "build",
          "stage:mpv"
        ]
      },
      "make": {
        "cache": true,
        "dependsOn": [
          "build",
          "stage:mpv"
        ],
        "inputs": [
          "production",
          "^production",
          {
            "dependentTasksOutputFiles": "**/*",
            "transitive": true
          },
          {
            "env": "RAVEN_SIGN_IDENTITY"
          },
          {
            "env": "RAVEN_NOTARIZE_PROFILE"
          },
          {
            "runtime": "xcodebuild -version"
          },
          {
            "runtime": "uname -m"
          }
        ],
        "outputs": [
          "{projectRoot}/out"
        ]
      },
      "audit:bundle": {
        "cache": false
      },
      "smoke:packaged": {
        "cache": false
      },
      "release:assets": {
        "cache": false
      }
    }
  },
  "productName": "Raven"
}

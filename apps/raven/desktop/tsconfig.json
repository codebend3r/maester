{
  // Bun reads `paths` from the nearest tsconfig.json, so the alias lives here as
  // well as in each referenced config.
  "files": [],
  "compilerOptions": {
    "paths": { "@/e2e/*": ["./e2e/*"], "@/*": ["./src/*"] }
  },
  "references": [{ "path": "./tsconfig.main.json" }, { "path": "./tsconfig.preload.json" }]
}

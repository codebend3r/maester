{
  "name": "@raven/music",
  "version": "0.7.8",
  "private": true,
  "description": "Wren, raven's music app for iPhone, iPad and Android phones",
  "main": "index.ts",
  "imports": {
    "#package": "./package.json",
    "#app-config": "./app.config.ts",
    "#plugins/*": "./plugins/*.ts"
  },
  "scripts": {
    "build:android": "./android/gradlew -p android assembleRelease",
    "build:ios": "DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer} xcodebuild -workspace ios/Wren.xcworkspace -scheme Wren -configuration Release -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath build/ios ARCHS=arm64 ONLY_ACTIVE_ARCH=NO CODE_SIGN_IDENTITY=- CODE_SIGNING_REQUIRED=NO build",
    "dev:android": "APP_VARIANT=development expo run:android",
    "dev:ios": "APP_VARIANT=development NODE_PATH=$PWD/node_modules DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer} expo run:ios --device wren-phone",
    "e2e": "DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer} maestro test --platform ios e2e",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint:ts": "oxlint",
    "lint:ts:fix": "oxlint --fix",
    "prebuild:android": "expo prebuild --platform android --clean",
    "prebuild:ios": "NODE_PATH=$PWD/node_modules REACT_NATIVE_NODE_MODULES_DIR=$PWD/node_modules DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer} expo prebuild --platform ios --clean",
    "predev:android": "APP_VARIANT=development bun run prebuild:android",
    "predev:ios": "APP_VARIANT=development bun run prebuild:ios",
    "start": "bun run --sequential start:watchman start:metro",
    "start:metro": "expo start",
    "start:watchman": "watchman --version",
    "test": "bun test --dots --path-ignore-patterns=**/*.render.test.tsx src",
    "test:screens": "NODE_PATH=$PWD/node_modules jest",
    "typecheck": "bun run --parallel typecheck:app typecheck:node",
    "typecheck:app": "tsgo --noEmit -p tsconfig.json",
    "typecheck:node": "tsgo --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@babel/runtime": "7.29.7",
    "@expo/metro-runtime": "58.0.14",
    "@raven/audio": "workspace:*",
    "@raven/core": "workspace:*",
    "@raven/native": "workspace:*",
    "@raven/ui": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "5.103.1",
    "expo": "58.0.14",
    "expo-constants": "58.0.12",
    "expo-file-system": "58.0.9",
    "expo-linking": "58.0.13",
    "expo-router": "58.0.23",
    "expo-splash-screen": "58.0.10",
    "react": "19.3.0",
    "react-native": "npm:react-native-tvos@0.88.0-0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "babel-preset-expo": "58.0.17",
    "jest": "30.5.2",
    "jest-expo": "58.0.11",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "test-renderer": "1.3.0"
  },
  "jest": {
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/jestSetup.ts"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.render.test.tsx"
    ],
    "testTimeout": 30000,
    "transformIgnorePatterns": [
      "/node_modules/(?!(\\.bun|react-native|@react-native|@react-native-community|expo|@expo|react-navigation|@react-navigation|standard-navigation))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "react-native-reanimated",
        "react-native-worklets",
        "react-native-gesture-handler"
      ]
    }
  },
  "nx": {
    "projectType": "application",
    "tags": [
      "scope:raven",
      "lang:ts"
    ],
    "includedScripts": [
      "start",
      "prebuild:ios",
      "prebuild:android",
      "build:ios",
      "build:android",
      "typecheck",
      "lint:ts",
      "lint:ts:fix",
      "format",
      "format:check",
      "test",
      "test:screens",
      "e2e",
      "dev:ios",
      "dev:android"
    ],
    "targets": {
      "start": {
        "continuous": true,
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      },
      "test:screens": {
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production"
        ],
        "cache": true
      },
      "build:ios": {
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production",
          {
            "env": "APP_VARIANT"
          },
          {
            "env": "EXPO_PUBLIC_RAVEN_BYPASS_ORIGIN"
          },
          {
            "env": "WREN_CARPLAY"
          },
          {
            "env": "DEVELOPER_DIR"
          },
          {
            "runtime": "xcodebuild -version"
          }
        ],
        "outputs": [
          "{projectRoot}/ios/Podfile.lock",
          "{projectRoot}/ios/Pods/Manifest.lock",
          "{projectRoot}/build/ios/Build/Products/Release-iphonesimulator/Wren.app"
        ],
        "cache": true
      },
      "build:android": {
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production",
          {
            "env": "APP_VARIANT"
          },
          {
            "env": "EXPO_PUBLIC_RAVEN_BYPASS_ORIGIN"
          },
          {
            "env": "ORG_GRADLE_PROJECT_reactNativeArchitectures"
          }
        ],
        "outputs": [
          "{projectRoot}/android"
        ],
        "cache": true
      },
      "prebuild:ios": {
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production",
          {
            "env": "APP_VARIANT"
          },
          {
            "env": "EXPO_PUBLIC_RAVEN_BYPASS_ORIGIN"
          },
          {
            "env": "WREN_CARPLAY"
          },
          {
            "env": "DEVELOPER_DIR"
          },
          {
            "runtime": "xcodebuild -version"
          }
        ],
        "outputs": [
          "{projectRoot}/ios"
        ],
        "cache": true
      },
      "prebuild:android": {
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production",
          {
            "env": "APP_VARIANT"
          },
          {
            "env": "EXPO_PUBLIC_RAVEN_BYPASS_ORIGIN"
          }
        ],
        "outputs": [
          "{projectRoot}/android"
        ],
        "cache": true
      },
      "e2e": {
        "inputs": [
          "default",
          "^production",
          {
            "env": "APP_VARIANT"
          },
          {
            "env": "EXPO_PUBLIC_RAVEN_BYPASS_ORIGIN"
          },
          {
            "env": "DEVELOPER_DIR"
          },
          {
            "runtime": "xcodebuild -version"
          },
          "{workspaceRoot}/.github/actions/raven-app-setup/**/*",
          "{workspaceRoot}/apps/raven/server/src/**/*"
        ],
        "cache": true
      },
      "dev:ios": {
        "continuous": true,
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      },
      "dev:android": {
        "continuous": true,
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      }
    }
  }
}

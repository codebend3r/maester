{
  "name": "@raven/web",
  "version": "0.5.4",
  "private": true,
  "type": "module",
  "imports": {
    "#package": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsgo --noEmit",
    "lint:ts": "oxlint",
    "lint:ts:fix": "oxlint --fix",
    "lint:css": "gale \"src/**/*.scss\"",
    "lint:css:fix": "gale --fix \"src/**/*.scss\"",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "bun run --sequential test:run test:coverage",
    "test:run": "bun test --dots --parallel --coverage --coverage-reporter=lcov",
    "test:coverage": "bun ../../../tooling/web/check-coverage.ts --lines 96 --functions 88",
    "test:watch": "bun test --dots --watch"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/young-serif": "5.3.0",
    "@raven/core": "workspace:*",
    "@raven/ui": "workspace:*",
    "@tanstack/react-query": "5.103.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@codebend3r/gale": "0.2.5",
    "@happy-dom/global-registrator": "20.14.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "6.1.1",
    "happy-dom": "20.14.5",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "sass": "1.104.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "nx": {
    "projectType": "application",
    "tags": [
      "scope:web",
      "lang:ts"
    ],
    "includedScripts": [
      "dev",
      "build",
      "preview",
      "typecheck",
      "lint:ts",
      "lint:ts:fix",
      "lint:css",
      "lint:css:fix",
      "format",
      "format:check",
      "test",
      "test:watch"
    ],
    "targets": {
      "build": {
        "inputs": [
          "production",
          "^production",
          {
            "env": "RAVEN_API_ORIGIN"
          },
          {
            "env": "NETLIFY"
          },
          {
            "env": "VITE_RAVEN_VERSION"
          }
        ]
      }
    }
  }
}

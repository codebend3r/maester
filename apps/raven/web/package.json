{
  "name": "@raven/web",
  "version": "0.10.2",
  "private": true,
  "type": "module",
  "imports": {
    "#package": "./package.json"
  },
  "scripts": {
    "axe": "playwright test --config playwright.axe.config.ts",
    "axe:ci": "playwright test --config playwright.axe.config.ts --reporter=github,html",
    "build": "vite build",
    "dead-code": "knip --no-progress --directory ../../.. --workspace apps/raven/web",
    "dead-css": "bun ../../../tooling/web/check-dead-css.ts .",
    "dev": "vite",
    "e2e:browser": "playwright test",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lighthouse": "bun run --sequential lighthouse:mobile lighthouse:desktop",
    "lighthouse:desktop": "lhci autorun --collect.settings.preset=desktop --upload.outputDir=.lighthouseci/desktop",
    "lighthouse:mobile": "lhci autorun --upload.outputDir=.lighthouseci/mobile",
    "lint:css": "gale \"src/**/*.scss\"",
    "lint:css:fix": "gale --fix \"src/**/*.scss\"",
    "lint:py": "uv run --project ../../sparrow/api ruff check --config ../../sparrow/api/pyproject.toml .",
    "lint:ts": "oxlint",
    "lint:ts:fix": "oxlint --fix",
    "one-command-per-script": "bash ../../../scripts/check_one_command_per_script.sh",
    "preview": "vite preview",
    "spellcheck": "uvx typos@1.51.1",
    "test": "bun run --sequential test:run test:coverage",
    "test:coverage": "bun ../../../tooling/web/check-coverage.ts --lines 96 --functions 88",
    "test:run": "bun test --dots --timeout=20000 --parallel --coverage --coverage-reporter=lcov",
    "test:watch": "bun test --dots --timeout=20000 --watch",
    "typecheck": "bun run --sequential typecheck:app typecheck:worker",
    "typecheck:app": "tsgo --noEmit",
    "typecheck:worker": "tsgo --noEmit -p tsconfig.worker.json"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/young-serif": "5.3.0",
    "@raven/core": "workspace:*",
    "@raven/ui": "workspace:*",
    "@shared/http": "workspace:*",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@tanstack/react-query": "5.107.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.5",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@codebend3r/gale": "0.4.1",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@tooling/web": "workspace:*",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "6.2.1",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "sass": "1.108.1",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "nx": {
    "projectType": "application",
    "tags": [
      "scope:web",
      "lang:ts"
    ],
    "includedScripts": [
      "dev",
      "build",
      "preview",
      "e2e:browser",
      "lighthouse",
      "typecheck",
      "lint:ts",
      "lint:ts:fix",
      "lint:css",
      "lint:css:fix",
      "format",
      "format:check",
      "test",
      "test:watch",
      "dead-code",
      "dead-css",
      "lint:py",
      "one-command-per-script",
      "spellcheck",
      "axe",
      "axe:ci"
    ],
    "targets": {
      "build": {
        "inputs": [
          "production",
          "^production",
          {
            "env": "NETLIFY"
          },
          {
            "env": "VITE_RAVEN_VERSION"
          }
        ]
      },
      "e2e:browser": {
        "cache": true,
        "dependsOn": [
          "build",
          "^build",
          {
            "projects": [
              "@shared/server"
            ],
            "target": "build"
          }
        ],
        "inputs": [
          "default",
          "^production",
          "againstServer"
        ]
      },
      "lighthouse": {
        "cache": true,
        "parallelism": false,
        "dependsOn": [
          "build",
          "^build",
          {
            "projects": [
              "@shared/server"
            ],
            "target": "build"
          }
        ],
        "inputs": [
          "default",
          "^production",
          "againstServer"
        ]
      },
      "dead-code": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/knip.ts",
          {
            "externalDependencies": [
              "knip"
            ]
          }
        ]
      },
      "dead-css": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "{projectRoot}/**/*.{ts,tsx,scss}",
          "{projectRoot}/tsconfig*.json",
          "^production",
          "{workspaceRoot}/tooling/tsconfig/*.json",
          "{workspaceRoot}/tooling/web/check-dead-css.ts",
          {
            "externalDependencies": [
              "sass",
              "typescript"
            ]
          }
        ]
      },
      "lint:py": {
        "cache": true,
        "inputs": [
          "{projectRoot}/**/*.py",
          "{workspaceRoot}/apps/sparrow/api/pyproject.toml"
        ]
      },
      "one-command-per-script": {
        "cache": true,
        "inputs": [
          "{projectRoot}/**/package.json",
          "{workspaceRoot}/scripts/check_one_command_per_script.sh"
        ]
      },
      "spellcheck": {
        "cache": true,
        "inputs": [
          "{projectRoot}/**/*",
          "{workspaceRoot}/typos.toml"
        ]
      },
      "axe": {
        "cache": true,
        "dependsOn": [
          "build",
          "^build",
          {
            "projects": [
              "@shared/server"
            ],
            "target": "build"
          }
        ],
        "inputs": [
          "default",
          "^production",
          "againstServer"
        ]
      },
      "axe:ci": {
        "cache": true,
        "dependsOn": [
          "build",
          "^build",
          {
            "projects": [
              "@shared/server"
            ],
            "target": "build"
          }
        ],
        "inputs": [
          "default",
          "^production",
          "againstServer"
        ]
      }
    }
  }
}

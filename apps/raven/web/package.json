{
  "name": "@raven/web",
  "version": "0.8.8",
  "private": true,
  "type": "module",
  "imports": {
    "#package": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "e2e:browser": "playwright test",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lighthouse": "bun run --sequential lighthouse:mobile lighthouse:desktop",
    "lighthouse:desktop": "lhci autorun --collect.settings.preset=desktop --upload.outputDir=.lighthouseci/desktop",
    "lighthouse:mobile": "lhci autorun --upload.outputDir=.lighthouseci/mobile",
    "lint:css": "gale \"src/**/*.scss\"",
    "lint:css:fix": "gale --fix \"src/**/*.scss\"",
    "lint:ts": "oxlint",
    "lint:ts:fix": "oxlint --fix",
    "preview": "vite preview",
    "test": "bun run --sequential test:run test:coverage",
    "test:coverage": "bun ../../../tooling/web/check-coverage.ts --lines 96 --functions 88",
    "test:run": "bun test --dots --parallel --coverage --coverage-reporter=lcov",
    "test:watch": "bun test --dots --watch",
    "typecheck": "bun run --sequential typecheck:app typecheck:worker",
    "typecheck:app": "tsgo --noEmit",
    "typecheck:worker": "tsgo --noEmit -p tsconfig.worker.json"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/young-serif": "5.3.0",
    "@raven/core": "workspace:*",
    "@raven/ui": "workspace:*",
    "@shared/http": "workspace:*",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@tanstack/react-query": "5.107.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.5",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@codebend3r/gale": "0.4.1",
    "@happy-dom/global-registrator": "21.0.4",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/scheduler": "0.28.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "6.2.1",
    "happy-dom": "21.0.4",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "sass": "1.108.1",
    "scheduler": "0.28.0",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "nx": {
    "projectType": "application",
    "tags": [
      "scope:web",
      "lang:ts"
    ],
    "includedScripts": [
      "dev",
      "build",
      "preview",
      "e2e:browser",
      "lighthouse",
      "typecheck",
      "lint:ts",
      "lint:ts:fix",
      "lint:css",
      "lint:css:fix",
      "format",
      "format:check",
      "test",
      "test:watch"
    ],
    "targets": {
      "build": {
        "inputs": [
          "production",
          "^production",
          {
            "env": "NETLIFY"
          },
          {
            "env": "VITE_RAVEN_VERSION"
          }
        ]
      },
      "e2e:browser": {
        "cache": true,
        "dependsOn": [
          "build",
          "^build",
          {
            "projects": [
              "@shared/server"
            ],
            "target": "build"
          }
        ],
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/apps/raven/server/src/**/*",
          "{workspaceRoot}/libs/shared/server/src/**/*"
        ]
      },
      "lighthouse": {
        "dependsOn": [
          "build",
          "^build",
          {
            "projects": [
              "@shared/server"
            ],
            "target": "build"
          }
        ],
        "cache": false
      }
    }
  }
}

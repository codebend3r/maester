{
  "ci": {
    "collect": {
      "startServerCommand": "bun lighthouse/serve.ts",
      "startServerReadyPattern": "Lighthouse server listening",
      "startServerReadyTimeout": 180000,
      "url": ["https://127.0.0.1:4173/", "https://127.0.0.1:4174/"],
      "settings": {
        "chromeFlags": "--ignore-certificate-errors"
      },
      "numberOfRuns": 5
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^https://127\\.0\\.0\\.1:",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 1,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1,
                "aggregationMethod": "median-run"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^https://127\\.0\\.0\\.1:4173/",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "median-run"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^https://127\\.0\\.0\\.1:4174/",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.7,
                "aggregationMethod": "median-run"
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}

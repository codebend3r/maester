{
  "extends": "../../../tooling/tsconfig/react.json",
  "compilerOptions": {
    "paths": {
      "@/e2e/*": ["./e2e/*"],
      "@/netlify/*": ["./netlify/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "e2e",
    "netlify",
    "lighthouse",
    "vite.config.ts",
    "playwright.config.ts",
    "../../../tooling/web"
  ],
  // The service worker compiles against the WebWorker library instead: tsconfig.worker.json.
  "exclude": ["src/serviceWorker/sw.ts"]
}

# Copy to .env beside the compose file and fill in. Never commit .env.
# Everything here is optional: without it raven works as before, with names
# read from the files.

# --- Metadata ---
# From themoviedb.org, Settings, API: either the API Read Access Token (long)
# or the API Key (32 characters); both work. Turns on posters, details, cast
# and crew for Movies libraries. Free for non-commercial use.
TMDB_API_TOKEN=
# The language titles and summaries come in.
METADATA_LANGUAGE=en-US
# Whose content rating and release date to show.
METADATA_COUNTRY=US
# OMDb's key (omdbapi.com/apikey.aspx), for IMDb, Rotten Tomatoes and
# Metacritic scores beside TMDB's. A free key allows 1,000 calls a day, so a
# big library fills over a few days.
OMDB_API_KEY=
# How many OMDb calls raven makes a day before waiting for midnight UTC.
OMDB_DAILY_LIMIT=1000
# MDBList's key (mdblist.com/preferences), for Rotten Tomatoes and Metacritic
# scores of shows, which OMDb has none for. A free key allows 1,000 calls a
# day, so a big library fills over a few days.
MDBLIST_API_KEY=
# How many MDBList calls raven makes a day before waiting for midnight UTC.
MDBLIST_DAILY_LIMIT=1000

# --- AI lookup ---
# raven's own Anthropic API key (console.anthropic.com), not one shared with
# other tools. With it, each show folder or movie the matcher leaves
# unmatched gets one lookup over TMDB's results: a sure pick matches the
# files, an unsure one is suggested under Not matched. The file and folder
# names of Movies, TV, Anime, Family and Documentaries libraries are sent to
# Anthropic, locked ones too: the lock hides them from browsers, not from
# TMDB or the lookup. Sporting events, YouTube videos and Other libraries
# never are.
ANTHROPIC_API_KEY=
# The model the lookup asks.
AI_MATCH_MODEL=claude-haiku-5-5
# How hard it thinks: low, medium, high, xhigh or max.
AI_MATCH_EFFORT=low
# How many lookups raven makes a day; the count starts again at midnight UTC.
# What the limit skips waits for the library's next pass (a scan, a change of
# its type or layout, a restart or Match again), not for midnight. With the
# default model at low effort, 200 cost at most about 20 cents a day.
AI_DAILY_LIMIT=200

# --- Device downloads ---
# How many GiB, as a whole number, of MP4 copies made for devices that cannot
# play a video's original (an MKV on an iPad) are kept under
# DATA_DIR/device-downloads. Past it the least recently served go first.
DEVICE_DOWNLOAD_CACHE_GB=300

# --- Music ---
# How many GiB, as a whole number, of tracks converted to AAC (for offline downloads, cellular
# streaming and the 128, 256 and 320 kbps steps) are kept under
# DATA_DIR/transcodes. Past it the least recently served go first, at start
# and every 6 hours.
TRANSCODE_CACHE_GB=20
# Measure the loudness (EBU R128) of the music tracks whose tags carry no
# ReplayGain, in the background at the lowest CPU priority, giving way to
# playback; off leaves them unlevelled.
LOUDNESS_SCAN=on
# raven's Last.fm API account (https://www.last.fm/api/account/create), for
# scrobbling: each account then links its own Last.fm from Settings or Wren.
# Both set turn Last.fm on; either missing leaves it off. ListenBrainz needs
# no key of the server's. Sign-in comes back through RAVEN_WEB_URL (or the
# public media origin without accounts), so set the API account's callback
# to that origin. Never logged.
LASTFM_API_KEY=
LASTFM_API_SECRET=

# --- Privacy ---
# The PIN that opens locked libraries (Edit library, Lock with the PIN).
# Without it no library can be locked, and one already locked stays shut.
LIBRARY_PIN=
# The password that turns the admin lock off (Settings, at the foot) in one
# browser. While the lock is on, locked libraries are hidden altogether, no
# video can be deleted and no file path is shown, and libraries, matches,
# metadata and settings cannot be changed: viewers browse and play. At least
# 10 characters, with lower and upper case letters, a digit and a symbol;
# unset or weaker, the lock stays on everywhere.
ADMIN_PASSWORD=

# --- Accounts (Supabase) ---
# All three set and valid turn accounts on ("ready"). Use a publishable key,
# never a secret/service-role key. HTTPS origins only, except loopback in dev.
# Once accounts are ready, every route needs an approved account except
# /api/health, the sign-in config (/api/auth/config) and the media origin
# ping (/api/media-origins/ping) and the Remote Access echo
# (/api/remote-access/echo/:nonce), which answer anyone, and /api/me, which
# answers any signed-in account its own status. The admin password no longer
# authorizes anything. Leave all three unset and raven runs open, with the
# admin password and the library PIN, as before.
# A server that has run with accounts ready remembers it. If these settings
# later go missing or turn invalid, it answers 503 everywhere but
# /api/health, /api/auth/config and /api/media-origins/ping, and never falls
# back to open access by itself.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# RAVEN_WEB_URL is also where raven asks to be checked from outside its
# network (Admin, Remote Access): the site's /remote-access/check function,
# which answers only a check signed with RAVEN_PROXY_SECRET (below). Without
# both, the check is not made and Admin says so.
RAVEN_WEB_URL=
# Security rollback, for an operator who means to open a server that enforced
# accounts: set to exactly "off" with the three above unset. It forgets the
# record and reopens raven to anonymous viewers, and logs a warning on every
# start while it is set. Remove it again afterwards. Set together with the
# three above, it is a conflict and the server answers 503 until one goes.
RAVEN_ACCOUNTS=

# --- Media plane (Netlify) ---
# Without these, raven behaves as before: media URLs are relative and go
# wherever /api goes. With them, a web app on Netlify can fetch video
# straight from raven instead of through Netlify's proxy, which bills every
# byte it carries as bandwidth. raven warns at boot when RAVEN_WEB_ORIGINS is
# set without RAVEN_MEDIA_ORIGINS, and whenever a web origin's media first
# comes through its proxy. Viewers away from home reach the public origin
# Admin's Remote Access names, which raven lists after these by itself.
# Origins the browser may fetch media from, best first. Each kind:url, where
# kind is lan or public. https only, with no path; http is for localhost.
RAVEN_MEDIA_ORIGINS=lan:https://raven.home.example.com
# Origins allowed to call the media routes cross-origin: the Netlify site and
# its previews. One * is allowed, in the first hostname label only, anywhere
# in it, standing for one or more characters other than a dot, as in
# https://deploy-preview-*--raven-player.netlify.app. http is for localhost.
# Add http://localhost:5173,http://localhost:5174 so `bun run dev:raven:vhagar`
# plays straight from this raven.
RAVEN_WEB_ORIGINS=https://raven-player.netlify.app
# The secret Netlify signs each proxied /api request with (the site's
# RAVEN_PROXY_SECRET, which netlify.toml's signed proxy names), so the rate
# limits count each visitor of the Netlify site by their own address, and
# raven signs its reachability check with it. 32 characters or more (openssl
# rand -base64 33); unset, visitors share Netlify's address and no check is
# made.
RAVEN_PROXY_SECRET=
# The reverse proxies whose X-Forwarded-For raven believes, comma separated,
# each an address or a CIDR range, as raven's socket sees them: behind DSM's
# reverse proxy in Docker, the compose network's gateway. raven walks the
# header from the right past them to the client. Unset, it believes no
# header, and a private socket that forwards one is taken for the internet,
# so every viewer away from home shares one rate limit. A malformed entry
# stops the server.
RAVEN_TRUSTED_PROXIES=
# Signs media tickets. 32 random bytes or more, base64 (openssl rand -base64
# 32). Rotating it ends every ticket. Servers without accounts need it for
# the origins; with accounts ready it signs nothing and is not needed.
RAVEN_MEDIA_SECRET=

# --- Development ---
# Where `bunx nx run @raven/web:dev` proxies /api, instead of the local
# server on http://localhost:8484: another raven's origin, such as
# http://192.168.50.6:8484 for Vhagar, read live from its database. Editing
# this line restarts Vite onto the new backend. Not read by the server.
RAVEN_DEV_API_ORIGIN=

# How many Continue watching tiles the home page shows before its See all link
# to the full list, a whole number of at least 1. Read when the web app is
# built or served by Vite, not by the server. Unset, it is 6.
RAVEN_HOME_CONTINUE_COUNT=

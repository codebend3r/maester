{
  "name": "scripts",
  "private": true,
  "description": "Repo tooling: the tracker catalog and its issue and board sync, NAS deploy, version bump. Linted and tested with luwin's pinned ruff, pytest and config",
  "scripts": {
    "format": "uv run --project ../apps/luwin/api ruff format --config ../apps/luwin/api/pyproject.toml .",
    "format:check": "uv run --project ../apps/luwin/api ruff format --config ../apps/luwin/api/pyproject.toml --check .",
    "lint:py": "uv run --project ../apps/luwin/api ruff check --config ../apps/luwin/api/pyproject.toml .",
    "lint:py:fix": "uv run --project ../apps/luwin/api ruff check --config ../apps/luwin/api/pyproject.toml --fix .",
    "test": "uv run --project ../apps/luwin/api pytest -q tests"
  },
  "nx": {
    "projectType": "library",
    "tags": [
      "scope:repo",
      "lang:py"
    ],
    "includedScripts": [
      "lint:py",
      "lint:py:fix",
      "format",
      "format:check",
      "test"
    ]
  }
}

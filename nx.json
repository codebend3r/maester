{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "workspaceLayout": {
    "appsDir": "apps",
    "libsDir": "libs"
  },
  "namedInputs": {
    "sharedGlobals": ["{workspaceRoot}/tsconfig.base.json", "{workspaceRoot}/tooling/**/*"],
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/tests/**/*",
      "!{projectRoot}/**/*.test.{ts,tsx}",
      "!{projectRoot}/src/test/**/*",
      "!{projectRoot}/src/test-setup.ts",
      "!{projectRoot}/vitest.config.ts",
      "!{projectRoot}/bunfig.toml"
    ],
    "expoVariant": [
      {
        "env": "APP_VARIANT"
      },
      {
        "env": "EXPO_PUBLIC_RAVEN_BYPASS_ORIGIN"
      }
    ],
    "xcode": [
      {
        "env": "DEVELOPER_DIR"
      },
      {
        "runtime": "xcodebuild -version"
      }
    ],
    "gradle": [
      {
        "env": "ORG_GRADLE_PROJECT_reactNativeArchitectures"
      }
    ],
    "againstServer": [
      "{workspaceRoot}/apps/raven/server/src/**/*",
      "{workspaceRoot}/libs/shared/server/src/**/*"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "cache": true
    },
    "lint:ts": {
      "inputs": ["default"],
      "cache": true
    },
    "lint:py": {
      "inputs": ["default"],
      "cache": true
    },
    "lint:css": {
      "inputs": ["default"],
      "cache": true
    },
    "format:check": {
      "inputs": ["default"],
      "cache": true
    },
    "eval": {
      "inputs": [
        "{projectRoot}/sparrow/**/*.py",
        "{projectRoot}/evals/**/*",
        "{projectRoot}/pyproject.toml",
        "{projectRoot}/uv.lock",
        { "env": "SPARROW_MODEL" }
      ],
      "outputs": ["{workspaceRoot}/apps/sparrow/docs/evals.md"],
      "cache": true
    },
    "dev": {
      "dependsOn": ["^build"],
      "continuous": true,
      "cache": false
    },
    "preview": {
      "cache": false
    }
  },
  "analytics": true,
  "nxCloudId": "6ad04421f895fd4c05aa78ef",
  "affected": {
    "legacy": true
  }
}

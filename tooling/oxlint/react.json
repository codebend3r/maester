{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["./base.json"],
  "plugins": ["typescript", "oxc", "unicorn", "react", "jsx-a11y", "import", "promise"],
  "env": {
    "browser": true
  },
  "rules": {
    // React 19 with the automatic JSX runtime: React is never in scope.
    "react/react-in-jsx-scope": "off",
    // Side-effect imports are how fonts and globals.scss get pulled into main.tsx.
    "import/no-unassigned-import": "off",
    // Fetch chains here exist for their side effects, not to pass values on.
    "promise/always-return": "off",
    // Safari before 18 and Chrome before 126 have no URL.parse, so a call blanks the page there.
    "no-restricted-properties": [
      "error",
      {
        "object": "URL",
        "property": "parse",
        "message": "Older Safari and Chrome lack URL.parse; use new URL() in a try."
      }
    ]
  }
}

# Copy to .env and fill in. Never commit .env.

# --- LLM ---
ANTHROPIC_API_KEY=
MAESTER_MODEL=claude-opus-5-5
MAESTER_EFFORT=medium

# --- Discord ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_REQUESTS_CHANNEL_ID=
DISCORD_ADMIN_CHANNEL_ID=
DISCORD_ROLE_TRUSTED=
DISCORD_ROLE_ADMIN=

# --- Seerr (single) ---
SEERR_URL=http://192.168.50.3:5055
SEERR_API_KEY=
# Seerr's webhook agent sends this as its Authorization Header; the route refuses all without it.
SEERR_WEBHOOK_SECRET=

# --- Plex (single) ---
PLEX_URL=http://192.168.50.3:32400
PLEX_TOKEN=

# --- Wizarr (single) ---
WIZARR_URL=http://192.168.50.2:5690
WIZARR_API_KEY=
INVITE_EXPIRES_DAYS=7

# --- English dubs ---
# Requests for an English dub carry this tag (it must exist in the Sonarr/Radarr
# Seerr sends to), and use this quality profile when one by that name exists.
DUB_TAG=dub
DUB_PROFILE=Dual Audio

# --- Per-host stacks: always name the host ---
SONARR_MELEYS_URL=http://192.168.50.2:27021
SONARR_MELEYS_API_KEY=
RADARR_MELEYS_URL=http://192.168.50.2:7878
RADARR_MELEYS_API_KEY=
SABNZBD_MELEYS_URL=http://192.168.50.2:27020
SABNZBD_MELEYS_API_KEY=
TAUTULLI_MELEYS_URL=http://192.168.50.2:8181
TAUTULLI_MELEYS_API_KEY=

SONARR_VERMITHOR_URL=http://192.168.50.3:27021
SONARR_VERMITHOR_API_KEY=
RADARR_VERMITHOR_URL=http://192.168.50.3:7878
RADARR_VERMITHOR_API_KEY=
SABNZBD_VERMITHOR_URL=http://192.168.50.3:27020
SABNZBD_VERMITHOR_API_KEY=
TAUTULLI_VERMITHOR_URL=http://192.168.50.3:27022
TAUTULLI_VERMITHOR_API_KEY=

# --- Guardrails ---
REPLACE_DAILY_CAP=3
STORAGE_PAUSE_4K_PERCENT=90
USER_MESSAGES_PER_HOUR=30
USER_TOKENS_PER_DAY=200000

# --- Storage and web ---
MAESTER_DB_PATH=/data/maester.db
WEB_PORT=8020

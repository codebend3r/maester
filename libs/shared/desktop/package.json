{
  "name": "@shared/desktop",
  "version": "0.10.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    }
  },
  "scripts": {
    "build": "bun run --sequential build:clean build:compile build:aliases",
    "build:aliases": "tsc-alias -p tsconfig.build.json",
    "build:clean": "rm -rf dist",
    "build:compile": "tsc -p tsconfig.build.json",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint:ts": "oxlint",
    "lint:ts:fix": "oxlint --fix",
    "test": "bun test --dots src",
    "test:watch": "bun test --watch src",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@electron-forge/maker-base": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@shared/http": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "tsc-alias": "1.9.10",
    "typescript": "6.0.3"
  },
  "nx": {
    "projectType": "library",
    "tags": [
      "scope:desktop",
      "lang:ts"
    ],
    "includedScripts": [
      "build",
      "typecheck",
      "lint:ts",
      "lint:ts:fix",
      "format",
      "format:check",
      "test",
      "test:watch"
    ]
  }
}

{
  "name": "@raven/mpv",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "audit:native": "bun src/build/auditNative.ts",
    "build": "bun run --sequential build:clean build:compile build:aliases",
    "build:aliases": "tsc-alias -p tsconfig.build.json",
    "build:clean": "rm -rf dist",
    "build:compile": "tsc -p tsconfig.build.json",
    "build:native": "bun src/build/buildAddon.ts",
    "fetch:libmpv": "bun src/build/buildLibmpv.ts",
    "fetch:sources": "bun src/build/fetchSources.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint:ts": "oxlint",
    "lint:ts:fix": "oxlint --fix",
    "test": "bun test --dots src",
    "test:native": "node --import tsx --test --test-timeout=120000 test/native.test.ts",
    "test:watch": "bun test --dots --watch src",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@raven/core": "workspace:*",
    "node-addon-api": "8.5.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "bun-types": "1.4.2",
    "cmake-js": "7.3.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "tsc-alias": "1.9.7",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "nx": {
    "projectType": "library",
    "tags": [
      "scope:desktop",
      "lang:ts"
    ],
    "includedScripts": [
      "build",
      "typecheck",
      "lint:ts",
      "lint:ts:fix",
      "format",
      "format:check",
      "test",
      "test:watch",
      "fetch:sources",
      "fetch:libmpv",
      "build:native",
      "test:native",
      "audit:native"
    ],
    "targets": {
      "fetch:sources": {
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      },
      "fetch:libmpv": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "{projectRoot}/native/sources.lock.json",
          "{projectRoot}/native/patches/**/*",
          "{projectRoot}/src/build/**/*",
          "!{projectRoot}/src/build/**/*.test.ts",
          "!{projectRoot}/src/build/buildAddon.ts",
          "!{projectRoot}/src/build/auditNative.ts",
          "!{projectRoot}/src/build/symbols.ts",
          "{workspaceRoot}/tsconfig.base.json",
          {
            "externalDependencies": [
              "node-addon-api"
            ]
          },
          {
            "runtime": "xcodebuild -version"
          },
          {
            "runtime": "uname -m"
          }
        ],
        "outputs": [
          "{projectRoot}/native-build/archives",
          "{projectRoot}/native-build/prefix",
          "{projectRoot}/native-build/source-bundle",
          "{projectRoot}/resources"
        ]
      },
      "build:native": {
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      },
      "test:native": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production",
          {
            "runtime": "xcodebuild -version"
          },
          {
            "runtime": "uname -m"
          }
        ]
      },
      "audit:native": {
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      }
    }
  }
}

{
  "name": "@raven/mpv",
  "version": "0.7.6",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "audit:native": "bun src/build/auditNative.ts",
    "audit:native:windows": "bun src/build/auditWindows.ts",
    "build": "bun run --sequential build:clean build:compile build:aliases",
    "build:aliases": "tsc-alias -p tsconfig.build.json",
    "build:clean": "rm -rf dist",
    "build:compile": "tsc -p tsconfig.build.json",
    "build:native": "bun src/build/buildAddon.ts",
    "build:native:windows": "bun src/build/buildWindowsAddon.ts",
    "fetch:libmpv": "bun src/build/buildLibmpv.ts",
    "fetch:libmpv:windows": "bun src/build/fetchWindowsLibmpv.ts",
    "fetch:sources": "bun src/build/fetchSources.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint:ts": "oxlint",
    "lint:ts:fix": "oxlint --fix",
    "test": "bun test --dots --path-ignore-patterns=native-build src",
    "test:native": "node --import tsx --test --test-timeout=120000 test/native.test.ts",
    "test:native:windows": "node --import tsx --test --test-timeout=120000 test/native.test.ts",
    "test:watch": "bun test --dots --watch src",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@raven/core": "workspace:*",
    "node-addon-api": "8.5.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "bun-types": "1.4.2",
    "cmake-js": "7.3.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "tsc-alias": "1.9.7",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "nx": {
    "projectType": "library",
    "tags": [
      "scope:desktop",
      "lang:ts"
    ],
    "includedScripts": [
      "build",
      "typecheck",
      "lint:ts",
      "lint:ts:fix",
      "format",
      "format:check",
      "test",
      "test:watch",
      "fetch:sources",
      "fetch:libmpv",
      "build:native",
      "test:native",
      "audit:native",
      "fetch:libmpv:windows",
      "audit:native:windows",
      "build:native:windows",
      "test:native:windows"
    ],
    "namedInputs": {
      "windowsNativeScripts": [
        "{projectRoot}/native/windows.lock.json",
        "{projectRoot}/src/target.ts",
        "{projectRoot}/src/build/context.ts",
        "{projectRoot}/src/pe.ts",
        "{projectRoot}/src/windows.ts",
        "{projectRoot}/src/build/windowsLock.ts",
        "{projectRoot}/src/build/auditWindows.ts",
        "{workspaceRoot}/tsconfig.base.json"
      ]
    },
    "targets": {
      "fetch:sources": {
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      },
      "fetch:libmpv": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "{projectRoot}/native/sources.lock.json",
          "{projectRoot}/native/patches/**/*",
          "{projectRoot}/src/build/**/*",
          "!{projectRoot}/src/build/**/*.test.ts",
          "!{projectRoot}/src/build/buildAddon.ts",
          "!{projectRoot}/src/build/auditNative.ts",
          "!{projectRoot}/src/build/symbols.ts",
          "{workspaceRoot}/tsconfig.base.json",
          {
            "externalDependencies": [
              "node-addon-api"
            ]
          },
          {
            "runtime": "xcodebuild -version"
          },
          {
            "runtime": "uname -m"
          }
        ],
        "outputs": [
          "{projectRoot}/native-build/archives",
          "{projectRoot}/native-build/prefix",
          "{projectRoot}/native-build/source-bundle",
          "{projectRoot}/resources"
        ]
      },
      "build:native": {
        "cache": false,
        "dependsOn": [
          "^build",
          "fetch:libmpv"
        ]
      },
      "test:native": {
        "cache": true,
        "dependsOn": [
          "^build",
          "build:native"
        ],
        "inputs": [
          "default",
          "^production",
          {
            "runtime": "xcodebuild -version"
          },
          {
            "runtime": "uname -m"
          }
        ]
      },
      "audit:native": {
        "cache": false,
        "dependsOn": [
          "^build",
          "build:native"
        ]
      },
      "fetch:libmpv:windows": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "windowsNativeScripts",
          "{projectRoot}/src/build/fetchWindowsLibmpv.ts"
        ],
        "outputs": [
          "{projectRoot}/native-build/archives/libmpv-win32-x64.7z",
          "{projectRoot}/resources/win32-x64"
        ]
      },
      "audit:native:windows": {
        "cache": true,
        "dependsOn": [
          "^build",
          "fetch:libmpv:windows"
        ],
        "inputs": [
          "windowsNativeScripts",
          "{projectRoot}/resources/win32-x64/libmpv-2.dll",
          "{projectRoot}/resources/win32-x64/include/**/*",
          "{projectRoot}/resources/win32-x64/provenance/build.json"
        ],
        "outputs": [
          "{projectRoot}/resources/win32-x64/provenance/artifacts.json"
        ]
      },
      "build:native:windows": {
        "cache": true,
        "dependsOn": [
          "^build",
          "fetch:libmpv:windows"
        ],
        "inputs": [
          "windowsNativeScripts",
          "{projectRoot}/native/addon.cpp",
          "{projectRoot}/src/build/compileAddon.ts",
          "{projectRoot}/native/surface.h",
          "{projectRoot}/native/surface_win.cpp",
          "{projectRoot}/native/CMakeLists.txt",
          "{projectRoot}/src/build/buildWindowsAddon.ts",
          "{projectRoot}/src/build/nodeHeaders.ts",
          "{projectRoot}/resources/win32-x64/libmpv-2.dll",
          "{projectRoot}/resources/win32-x64/include/**/*",
          {
            "externalDependencies": [
              "node-addon-api",
              "cmake-js"
            ]
          },
          {
            "runtime": "cmake --version"
          }
        ],
        "outputs": [
          "{projectRoot}/resources/win32-x64/raven_mpv.node",
          "{projectRoot}/resources/win32-x64/provenance",
          "{projectRoot}/native-build/addon",
          "{projectRoot}/native-build/node-headers",
          "{projectRoot}/native-build/archives/node-headers.tar.gz",
          "{projectRoot}/native-build/archives/node-LICENSE",
          "{projectRoot}/native-build/archives/node.lib",
          "{projectRoot}/native-build/libmpv.def"
        ]
      },
      "test:native:windows": {
        "cache": true,
        "dependsOn": [
          "^build",
          "build:native:windows"
        ],
        "inputs": [
          "default",
          "^production",
          "{projectRoot}/resources/win32-x64/raven_mpv.node",
          "{projectRoot}/resources/win32-x64/libmpv-2.dll",
          {
            "runtime": "ffmpeg -version"
          }
        ]
      }
    }
  }
}

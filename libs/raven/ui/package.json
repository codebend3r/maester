{
  "name": "@raven/ui",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./canPlay": {
      "types": "./dist/lib/canPlay.d.ts",
      "default": "./dist/canPlay.js"
    },
    "./designTokens": {
      "types": "./dist/styles/designTokens.d.ts",
      "default": "./dist/designTokens.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "bun run --sequential build:clean build:bundle build:types build:aliases",
    "build:aliases": "tsc-alias -p tsconfig.build.json",
    "build:bundle": "vite build",
    "build:clean": "rm -rf dist",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "dev": "vite build --watch",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint:css": "gale \"src/**/*.scss\"",
    "lint:css:fix": "gale --fix \"src/**/*.scss\"",
    "lint:ts": "oxlint",
    "lint:ts:fix": "oxlint --fix",
    "test": "bun run --sequential test:run test:coverage",
    "test:coverage": "bun ../../../tooling/web/check-coverage.ts --lines 96 --functions 88",
    "test:run": "bun test --dots --parallel --coverage --coverage-reporter=lcov",
    "test:watch": "bun test --dots --watch",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@raven/core": "workspace:*"
  },
  "devDependencies": {
    "@codebend3r/gale": "0.3.1",
    "@happy-dom/global-registrator": "20.14.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "6.1.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "sass": "1.104.1",
    "tsc-alias": "1.9.7",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "5.103.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "zustand": "5.0.15"
  },
  "nx": {
    "projectType": "library",
    "tags": [
      "scope:web",
      "lang:ts"
    ],
    "includedScripts": [
      "dev",
      "build",
      "typecheck",
      "lint:ts",
      "lint:ts:fix",
      "lint:css",
      "lint:css:fix",
      "format",
      "format:check",
      "test",
      "test:watch"
    ]
  }
}

{
  "name": "@raven/top-shelf",
  "version": "0.10.1",
  "private": true,
  "description": "The Apple TV's Top Shelf for raven and Wren: what the home screen shows above each app's tile",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    }
  },
  "scripts": {
    "build": "bun run --sequential build:clean build:compile build:aliases",
    "build:aliases": "tsc-alias -p tsconfig.build.json",
    "build:clean": "rm -rf dist",
    "build:compile": "tsc -p tsconfig.build.json",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint:ts": "oxlint",
    "lint:ts:fix": "oxlint --fix",
    "test": "bun test --dots src",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "expo-modules-core": "58.0.30"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "react-native": "npm:react-native-tvos@0.88.1-0",
    "tsc-alias": "1.9.10",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "react": "19.3.0"
  },
  "nx": {
    "projectType": "library",
    "tags": [
      "scope:raven",
      "lang:ts"
    ],
    "includedScripts": [
      "build",
      "typecheck",
      "lint:ts",
      "lint:ts:fix",
      "format",
      "format:check",
      "test"
    ],
    "targets": {
      "test": {
        "cache": true,
        "dependsOn": [
          "^build"
        ]
      },
      "typecheck": {
        "cache": true,
        "dependsOn": [
          "^build"
        ]
      },
      "build": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  }
}

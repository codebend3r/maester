{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // No `browser` or `node` env on purpose: this library runs in the web
  // client, the server, and any future native client, so it may only lean on
  // what every JavaScript runtime has.
  "extends": ["../../../tooling/oxlint/base.json"],
  "rules": {
    "no-console": "error"
  },
  "ignorePatterns": ["dist"],
  "overrides": [
    {
      "files": ["src/**/*.test.ts"],
      "rules": {
        "typescript/no-non-null-assertion": "off",
        "unicorn/consistent-function-scoping": "off"
      }
    }
  ]
}

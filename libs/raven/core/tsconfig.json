{
  "extends": "../../../tsconfig.base.json",
  // No DOM and no Node types: the library may only lean on what every
  // JavaScript runtime has, so a slip fails the typecheck.
  "compilerOptions": {
    "target": "ES2022",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": []
  },
  "include": ["src"]
}

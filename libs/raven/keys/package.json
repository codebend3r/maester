{
  "name": "@raven/keys",
  "version": "0.8.7",
  "private": true,
  "description": "raven's hardware keyboard for iPhones and iPads: the player's keys as UIKeyCommands, each press an event the app hears",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun run --sequential build:clean build:compile build:aliases",
    "build:aliases": "tsc-alias -p tsconfig.build.json",
    "build:clean": "rm -rf dist",
    "build:compile": "tsc -p tsconfig.build.json",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint:ts": "oxlint",
    "lint:ts:fix": "oxlint --fix",
    "test": "bun test --dots src",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@raven/core": "workspace:*",
    "expo-modules-core": "58.0.30"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "react-native": "npm:react-native-tvos@0.88.1-0",
    "tsc-alias": "1.9.10",
    "typescript": "6.0.3"
  },
  "nx": {
    "projectType": "library",
    "tags": [
      "scope:raven",
      "lang:ts"
    ],
    "includedScripts": [
      "build",
      "typecheck",
      "lint:ts",
      "lint:ts:fix",
      "format",
      "format:check",
      "test"
    ],
    "targets": {
      "test": {
        "cache": true,
        "dependsOn": [
          "^build"
        ]
      },
      "typecheck": {
        "cache": true,
        "dependsOn": [
          "^build"
        ]
      },
      "build": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  }
}

{
  "name": "@raven/native",
  "version": "0.8.9",
  "private": true,
  "description": "raven's sign-in and media access on React Native, shared by the device app and Wren",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "default": "./dist/headless.js"
    },
    "./polyfills": {
      "types": "./dist/polyfills.d.ts",
      "default": "./dist/polyfills.js"
    }
  },
  "scripts": {
    "build": "bun run --sequential build:clean build:compile build:aliases",
    "build:aliases": "tsc-alias -p tsconfig.build.json",
    "build:clean": "rm -rf dist",
    "build:compile": "tsc -p tsconfig.build.json",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint:ts": "oxlint",
    "lint:ts:fix": "oxlint --fix",
    "test": "bun test --dots src",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@formatjs/intl-displaynames": "8.0.1",
    "@formatjs/intl-getcanonicallocales": "3.3.0",
    "@formatjs/intl-locale": "5.4.2",
    "@formatjs/intl-pluralrules": "7.0.2",
    "@formatjs/intl-relativetimeformat": "13.0.1",
    "@raven/audio": "workspace:*",
    "@raven/core": "workspace:*",
    "@raven/ui": "workspace:*",
    "@react-native-community/netinfo": "12.0.1",
    "expo-secure-store": "58.0.2",
    "react-native-sse": "1.2.1",
    "react-native-svg": "15.16.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "react-native": "npm:react-native-tvos@0.88.1-0",
    "tsc-alias": "1.9.10",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "react": "19.3.0",
    "zustand": "5.1.0"
  },
  "nx": {
    "projectType": "library",
    "tags": [
      "scope:raven",
      "lang:ts"
    ],
    "includedScripts": [
      "build",
      "typecheck",
      "lint:ts",
      "lint:ts:fix",
      "format",
      "format:check",
      "test"
    ],
    "targets": {
      "test": {
        "cache": true,
        "dependsOn": [
          "^build"
        ]
      },
      "typecheck": {
        "cache": true,
        "dependsOn": [
          "^build"
        ]
      },
      "build": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  }
}

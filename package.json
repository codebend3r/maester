{
  "name": "maester",
  "private": true,
  "description": "Nx workspace for maester, a self-hosted media suite: raven, a media library and direct-play player, luwin, an AI assistant for the friends who share the server, rookery, the suite's sign-in, and the apps and libraries around them",
  "workspaces": [
    "apps/*/*",
    "libs/*/*",
    "scripts"
  ],
  "type": "module",
  "scripts": {
    "affected": "bun run --sequential spellcheck typescript-only one-command-per-script dead-code dead-css affected:tasks",
    "affected:tasks": "nx affected -t lint:py lint:ts lint:css format:check typecheck test test:screens build",
    "app:build:android-tv": "nx run @raven/app:build:android-tv",
    "app:build:ios": "nx run @raven/app:build:ios",
    "app:build:tvos": "nx run @raven/app:build:tvos",
    "app:dev:ios": "nx run @raven/app:dev:ios",
    "app:dev:ipad": "nx run @raven/app:dev:ipad",
    "app:dev:tvos": "nx run @raven/app:dev:tvos",
    "app:e2e": "nx run @raven/app:e2e",
    "app:e2e:android-tv": "nx run @raven/app:e2e:android-tv",
    "app:e2e:tvos": "nx run @raven/app:e2e:tvos",
    "app:prebuild:android-tv": "nx run @raven/app:prebuild:android-tv",
    "app:prebuild:ios": "nx run @raven/app:prebuild:ios",
    "app:prebuild:tvos": "nx run @raven/app:prebuild:tvos",
    "app:server": "nx run @raven/server:dev",
    "app:start": "nx run @raven/app:start",
    "ci:app:android-tv": "bash scripts/ci_app_android_tv.sh",
    "ci:app:ios": "bash scripts/ci_app_ios.sh",
    "ci:app:tvos": "bash scripts/ci_app_tvos.sh",
    "ci:desktop:e2e": "bash scripts/ci_desktop_e2e.sh",
    "ci:docker": "bash scripts/ci_docker.sh",
    "claude-audit": "bash scripts/audit_claude_md.sh",
    "build": "nx run-many -t build",
    "dead-code": "nx run maester:dead-code",
    "dead-css": "nx run maester:dead-css",
    "desktop:audit:bundle": "nx run @raven/desktop:audit:bundle",
    "desktop:build": "nx run @raven/desktop:build",
    "desktop:dev": "nx run @raven/desktop:dev",
    "desktop:e2e": "nx run @raven/desktop:e2e",
    "desktop:make": "nx run @raven/desktop:make",
    "desktop:release:assets": "nx run @raven/desktop:release:assets",
    "desktop:smoke:packaged": "nx run @raven/desktop:smoke:packaged",
    "desktop:test:native": "nx run @raven/desktop:test:native",
    "dev:luwin": "nx run-many -t dev -p @luwin/api @luwin/web",
    "dev:raven": "nx run-many -t dev -p @raven/server @raven/ui @raven/web",
    "dev:raven:prod": "RAVEN_DEV_API_ORIGIN=https://raven.tail5586d4.ts.net nx run-many -t dev -p @raven/ui @raven/web",
    "dev:raven:db": "scripts/pull_raven_db.sh",
    "build:raven:splash": "nx run @raven/splash:build",
    "dev:raven:splash": "nx run @raven/splash:dev",
    "dev:rookery": "nx run-many -t dev -p @rookery/server @rookery/web",
    "format": "nx run-many -t format",
    "format:check": "nx run-many -t format:check",
    "graph": "nx graph",
    "lint": "nx run-many -t lint:py lint:ts lint:css",
    "lint:css": "nx run-many -t lint:css",
    "lint:fix": "nx run-many -t lint:py:fix lint:ts:fix lint:css:fix",
    "lint:py": "nx run-many -t lint:py",
    "lint:ts": "nx run-many -t lint:ts",
    "lint-staged": "lint-staged",
    "mpv:native": "DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer} nx run-many -p @raven/mpv -t audit:native test:native",
    "mpv:native:windows": "nx run-many -p @raven/mpv -t audit:native:windows test:native:windows",
    "one-command-per-script": "nx run maester:one-command-per-script",
    "sandbox:luwin": "nx run-many -t sandbox -p @luwin/api @luwin/web",
    "spellcheck": "nx run maester:spellcheck",
    "test": "nx run-many -t test",
    "test:screens": "nx run-many -t test:screens",
    "typecheck": "nx run-many -t typecheck",
    "typescript-only": "nx run maester:typescript-only",
    "verify": "nx run-many -t spellcheck typescript-only one-command-per-script dead-code dead-css lint:py lint:ts lint:css format:check typecheck test test:screens build",
    "verify:uncached": "bun run verify --skip-nx-cache"
  },
  "devDependencies": {
    "knip": "6.41.0",
    "lefthook": "2.1.15",
    "lint-staged": "17.6.0",
    "nx": "23.2.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "sass": "1.104.1",
    "typescript": "6.0.3"
  },
  "overrides": {
    "react-native": "npm:react-native-tvos@0.88.0-0",
    "react-native-gesture-handler": "3.3.0"
  },
  "packageManager": "bun@1.4.2",
  "nx": {
    "includedScripts": [],
    "targets": {
      "format": {
        "command": "oxfmt ."
      },
      "format:check": {
        "command": "oxfmt --check ."
      },
      "spellcheck": {
        "command": "uvx typos@1.51.1",
        "cache": true,
        "inputs": [
          "{workspaceRoot}/**/*"
        ]
      },
      "typescript-only": {
        "command": "bash scripts/check_typescript_only.sh",
        "cache": true,
        "inputs": [
          "{workspaceRoot}/**/*.{js,jsx,mjs,cjs}",
          "{workspaceRoot}/scripts/check_typescript_only.sh"
        ]
      },
      "one-command-per-script": {
        "command": "bash scripts/check_one_command_per_script.sh",
        "cache": true,
        "inputs": [
          "{workspaceRoot}/**/package.json",
          "{workspaceRoot}/scripts/check_one_command_per_script.sh"
        ]
      },
      "dead-code": {
        "command": "knip --no-progress",
        "cache": true,
        "dependsOn": [
          {
            "projects": [
              "@raven/core",
              "@raven/ui"
            ],
            "target": "build"
          }
        ],
        "inputs": [
          "{workspaceRoot}/**/*.{ts,tsx,json,yml,yaml,toml}",
          {
            "externalDependencies": [
              "knip"
            ]
          }
        ]
      },
      "dead-css": {
        "command": "bun tooling/web/check-dead-css.ts",
        "cache": true,
        "dependsOn": [
          {
            "projects": [
              "@raven/core",
              "@raven/ui"
            ],
            "target": "build"
          }
        ],
        "inputs": [
          "{workspaceRoot}/apps/**/*.{ts,tsx,scss}",
          "{workspaceRoot}/libs/**/*.{ts,tsx,scss}",
          "{workspaceRoot}/**/package.json",
          "{workspaceRoot}/**/gale.json",
          "{workspaceRoot}/**/tsconfig*.json",
          "{workspaceRoot}/tooling/tsconfig/*.json",
          "{workspaceRoot}/tooling/web/check-dead-css.ts",
          {
            "externalDependencies": [
              "sass",
              "typescript"
            ]
          }
        ]
      }
    }
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "electron-winstaller",
    "lefthook",
    "nx",
    "supabase"
  ]
}
